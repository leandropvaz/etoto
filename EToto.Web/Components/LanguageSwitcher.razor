@rendermode InteractiveServer
@using EToto.Web.Services
@inject LanguageService Lang
@inject IJSRuntime JS
@implements IDisposable

<div class="lang-switcher">
    @foreach (var idioma in LanguageService.SupportedLanguages)
    {
        var codigo = idioma;
        var ativo = Lang.CurrentLanguage == codigo;
        <button type="button"
                class="lang-flag-btn @(ativo ? "lang-flag-active" : "")"
                title="@Titulo(codigo)"
                aria-label="@Titulo(codigo)"
                aria-pressed="@(ativo ? "true" : "false")"
                @onclick="() => SetLanguageAsync(codigo)">
            <span class="fi fi-@Bandeira(codigo) flag-icon"></span>
        </button>
    }
</div>

<style>
    /* As bordas eram quase brancas — herança da navbar escura do tema antigo.
       Na barra branca de hoje sumiam, e o idioma ativo virava adivinhação. */
    .lang-switcher { display: flex; align-items: center; gap: 2px; }

    .lang-flag-btn {
        background: transparent;
        border: 1px solid transparent;
        border-radius: var(--pw-r-1, 6px);
        width: 34px;
        height: 30px;
        padding: 0;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: border-color .12s ease, background-color .12s ease, opacity .12s ease;
        opacity: .55;
        line-height: 1;
        overflow: hidden;
    }

    .lang-flag-btn:hover {
        opacity: 1;
        background: var(--pw-vellum, #F0F3F8);
    }

    .lang-flag-btn:focus-visible {
        outline: 2px solid var(--pw-notice, #1570DB);
        outline-offset: 2px;
    }

    /* O ativo não é só "mais opaco": ganha a cor de ação e um anel. */
    .lang-flag-btn.lang-flag-active {
        opacity: 1;
        border-color: var(--pw-notice, #1570DB);
        box-shadow: 0 0 0 1px var(--pw-notice, #1570DB) inset;
    }

    .flag-icon {
        width: 21px;
        height: 15px;
        display: block;
        border-radius: 2px;
        background-size: cover;
    }
</style>

@code {
    // Bandeira (flag-icons) e nome por idioma. Quais idiomas aparecem é decidido
    // em LanguageService.SupportedLanguages — aqui só se diz como cada um se mostra.
    private static string Bandeira(string idioma) => idioma switch
    {
        "pt-BR" => "br",
        "en-US" => "us",
        "es-ES" => "es",
        _ => "un",
    };

    private static string Titulo(string idioma) => idioma switch
    {
        "pt-BR" => "Português (Brasil)",
        "en-US" => "English (US)",
        "es-ES" => "Español (España)",
        _ => idioma,
    };

    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "lototo_lang");
            // Só aceita idioma que ainda existe: um valor antigo no navegador não
            // pode deixar a interface presa numa língua que o sistema não tem mais.
            if (!string.IsNullOrEmpty(saved)
                && saved != Lang.CurrentLanguage
                && LanguageService.SupportedLanguages.Contains(saved))
            {
                Lang.SetLanguage(saved);
            }
        }
        catch { /* ignora durante pré-renderização */ }
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }

    private async Task SetLanguageAsync(string lang)
    {
        Lang.SetLanguage(lang);
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "lototo_lang", lang);
        }
        catch { /* ignora */ }
    }
}
