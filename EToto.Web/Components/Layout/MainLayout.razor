@using EToto.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inherits LayoutComponentBase
@inject AuthService AuthService
@inject NavigationManager Nav
@inject LanguageService Lang
@inject AmbienteInfo Ambiente
@implements IDisposable

<PageTitle>E-toto</PageTitle>

@* ── Barra branca: marca, contexto e conta ─────────────────────────────── *@
<header class="pw-top">

    <div class="pw-top__brand">
        <img src="images/etoto.png" alt="E-toto" />
    </div>

    <div class="pw-top__meta">
        <div class="pw-field pw-field--desk">
            <span class="pw-field__key">@Lang["nav.date"]</span>
            <span class="pw-field__val">@DateTime.Now.ToString("dd/MM/yyyy")</span>
        </div>

        @if (!IsSuperGestor)
        {
            <div class="pw-field">
                <span class="pw-field__key">@Lang["nav.plant_label"]</span>
                <span class="pw-field__val">@PlantaAtual</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(UserName))
        {
            <div class="pw-field pw-field--wide">
                <span class="pw-field__key">@Lang["nav.operator"]</span>
                <span class="pw-field__val">@UserName</span>
            </div>
        }

        @* Nunca some: sem este marcador, o celular mostra uma interface
           indistinguível da produção sobre dados fictícios. *@
        @if (Ambiente.EhHomologacao)
        {
            <div class="pw-field pw-field--env">
                <span class="pw-field__key">@Lang["nav.environment"]</span>
                <span class="pw-field__val">@Lang["env.homologacao"]</span>
            </div>
        }
    </div>

    <div class="pw-top__actions">
        <LanguageSwitcher />
        @if (!string.IsNullOrWhiteSpace(UserName))
        {
            <button class="pw-btn-ghost-dark" @onclick="Logout" title="@Lang["nav.logout"]">
                <i class="fas fa-sign-out-alt"></i>
                <span class="d-none d-sm-inline">@Lang["nav.logout"]</span>
            </button>
        }
    </div>
</header>

@* ── Trilho: abas em pílula na mesa, barra no polegar ──────────────────── *@
<nav class="pw-rail" aria-label="@Lang["nav.sections"]">

    <a class="@RailClass("/home")" href="/home">
        <i class="fas fa-search"></i><span>@Lang["nav.search"]</span>
    </a>

    @if (IsAdmin || IsSuperGestor)
    {
        <a class="@RailClass("/equipamentos")" href="/equipamentos">
            <i class="fas fa-tools"></i><span>@Lang["nav.equipments"]</span>
        </a>
    }
    else
    {
        <a class="pw-rail__item is-locked" href="#" tabindex="-1" aria-disabled="true" title="@Lang["nav.restricted_admin"]">
            <i class="fas fa-tools"></i><span>@Lang["nav.equipments"]</span><i class="fas fa-lock pw-rail__lock"></i>
        </a>
    }

    <a class="@RailClass("/ple")" href="/ple">
        <i class="fas fa-clipboard-check"></i><span>@Lang["nav.ple"]</span>
    </a>

    <a class="@RailClass("/avaliacao-risco")" href="/avaliacao-risco">
        <i class="fas fa-exclamation-triangle"></i><span>@Lang["nav.risk_assessment"]</span>
    </a>

    <a class="@RailClass("/painel")" href="/painel">
        <i class="fas fa-tv"></i><span>@Lang["nav.panel"]</span>
    </a>

    @if (IsAdmin || IsSuperGestor)
    {
        <a class="@RailClass("/usuarios")" href="/usuarios">
            <i class="fas fa-users-cog"></i><span>@Lang["nav.users"]</span>
        </a>
    }
    else
    {
        <a class="pw-rail__item is-locked" href="#" tabindex="-1" aria-disabled="true" title="@Lang["nav.restricted_admin"]">
            <i class="fas fa-users-cog"></i><span>@Lang["nav.users"]</span><i class="fas fa-lock pw-rail__lock"></i>
        </a>
    }

    @if (IsSuperGestor)
    {
        <a class="@RailClass("/plantas")" href="/plantas">
            <i class="fas fa-industry"></i><span>@Lang["nav.plants"]</span>
        </a>
    }
    else
    {
        <a class="pw-rail__item is-locked" href="#" tabindex="-1" aria-disabled="true" title="@Lang["nav.restricted_super"]">
            <i class="fas fa-industry"></i><span>@Lang["nav.plants"]</span><i class="fas fa-lock pw-rail__lock"></i>
        </a>
    }

    @* #4: Auditoria, Relatórios e Revalidação são sub-abas dentro de /usuarios. *@
</nav>

<main class="pw-main">
    @Body
</main>

<footer class="pw-foot">
    <a href="https://www.powerwavesolutions.net" target="_blank" rel="noopener">
        <img src="images/logo2.png" alt="Power Wave Solutions" />
        @* Sem filtro: a inversão existia para o rodapé escuro antigo e deixava
           a marca branca sobre branco, portanto invisível. *@
        <img src="images/logo3.png" alt="" />
    </a>
</footer>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string PlantaAtual { get; set; } = "";
    private string UserName { get; set; } = "";

    private bool IsAdmin { get; set; }
    private bool IsSuperGestor { get; set; }
    private bool IsUsuarioFinal { get; set; }
    private bool IsComandoCentral { get; set; }
    private bool TreinamentoConcluido { get; set; }

    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationStateTask is null)
        {
            UserName = "";
            PlantaAtual = "";
            IsAdmin = false;
            IsSuperGestor = false;
            return;
        }

        var authState = await AuthenticationStateTask;
        var user = authState.User;

        if (user.Identity is { IsAuthenticated: true })
        {
            UserName = user.Identity.Name ?? "";

            var plantaId = user.FindFirst("plantaId")?.Value;
            PlantaAtual = !string.IsNullOrWhiteSpace(plantaId)
                ? (user.FindFirst("PlantaNome")?.Value ?? Lang["nav.no_plant"])
                : Lang["nav.no_plant"];

            IsAdmin = user.IsInRole("Administrador");
            IsSuperGestor = user.IsInRole("SuperGestor");
            IsUsuarioFinal = user.IsInRole("UsuarioFinal");
            IsComandoCentral = user.IsInRole("ComandoCentral");
            TreinamentoConcluido = user.FindFirst("TreinamentoConcluido")?.Value == "True";
        }
        else
        {
            UserName = "";
            PlantaAtual = "";
            IsAdmin = false;
            IsSuperGestor = false;
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/", forceLoad: true);
    }

    // Marca a aba correspondente à rota atual.
    private string RailClass(string href)
    {
        var currentPath = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        var targetPath = Nav.ToAbsoluteUri(href).AbsolutePath.TrimEnd('/').ToLowerInvariant();

        if (currentPath == string.Empty)
            currentPath = "/";

        return currentPath == targetPath
            ? "pw-rail__item is-active"
            : "pw-rail__item";
    }
}
