@code {
    public enum PerfilUsuario
    {
        Usuario = 1,
        Administrador = 2,
        SuperGestor = 3,
        UsuarioFinal = 4,
        ComandoCentral = 5
    }

    public class UsuarioViewModel
    {
        public int Id { get; set; }

        [Required(ErrorMessage = "O login é obrigatório.")]
        public string Login { get; set; } = string.Empty;

        [Required(ErrorMessage = "O nome completo é obrigatório.")]
        public string NomeCompleto { get; set; } = string.Empty;

        [DataType(DataType.Password)]
        public string? Senha { get; set; }

        // Perfil "primário" derivado (SuperGestor quando presente, senão o primeiro de Perfis).
        // Usado para filtros e retrocompat.
        public PerfilUsuario Perfil { get; set; } = PerfilUsuario.Usuario;

        // Múltiplos perfis (#1c).
        public List<PerfilUsuario> Perfis { get; set; } = new();

        public bool Ativa { get; set; } = true;

        public int? PlantaId { get; set; }
        public List<int> PlantasIds { get; set; } = new();

        public bool TreinamentoConcluido { get; set; }
        public DateTime? DataTreinamento { get; set; }
        // Validade do treinamento (#3)
        public DateTime? DataValidadeTreinamento { get; set; }

        // Vínculo Funcionário/Terceiro (#2)
        public TipoVinculo TipoVinculo { get; set; } = TipoVinculo.Funcionario;
        public string? NomeEmpresa { get; set; }
        public DateTime? DataValidadeAcesso { get; set; }

        // Auditoria de cadastro (#1c)
        public string? CriadoPorNome { get; set; }
        public DateTime? CriadoEm { get; set; }
        public string? AlteradoPorNome { get; set; }
        public DateTime? AlteradoEm { get; set; }
    }

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private PerfilUsuario PerfilLogado { get; set; } = PerfilUsuario.Usuario;
    private List<int> PlantasIdsLogado { get; set; } = new(); // ✅ Múltiplas plantas do admin
    private int? UsuarioIdLogado { get; set; }

    private UsuarioViewModel UsuarioForm { get; set; } = new();
    private List<UsuarioViewModel> TodosUsuarios { get; set; } = new();
    private List<PlantasDto> Plantas { get; set; } = new();

    // #9: indicadores de carregamento
    private bool Carregando { get; set; } = true;
    private bool Salvando { get; set; }
    private bool Excluindo { get; set; }

    // Linha selecionada no datagrid
    private int? LinhaSelecionadaId { get; set; }

    private string TermoPesquisa { get; set; } = string.Empty;
    private int PaginaAtual { get; set; } = 1;
    private int TamanhoPagina { get; set; } = 10;

    private bool IsEditMode { get; set; } = false;
    private int? UsuarioEmEdicaoId { get; set; }
    private bool MostrarModalExcluir { get; set; } = false;

    // Toolbox: seção ativa entre Cadastro / Revalidação / Auditoria / Relatórios (#4).
    private enum Secao { Cadastro, Revalidacao, Auditoria, Relatorios }
    private Secao SecaoAtiva { get; set; } = Secao.Cadastro;

    // Revalidação/Auditoria/Relatórios são exclusivos de Administrador/SuperGestor.
    private bool PodeAdministrar =>
        PerfilLogado is PerfilUsuario.Administrador or PerfilUsuario.SuperGestor;

    // #2: limites da validade de acesso (Terceiro) — janela de [hoje, hoje + 6 meses].
    private DateTime DataLimiteValidade => VinculoValidacao.DataValidadeMaxima();
    private string DataMinValidade => DateTime.UtcNow.Date.ToString("yyyy-MM-dd");
    private string DataMaxValidade => DataLimiteValidade.ToString("yyyy-MM-dd");

    // Ao escolher Terceiro, sugere a validade máxima (hoje + 6 meses) se ainda não houver data.
    private void OnTipoVinculoChanged()
    {
        if (UsuarioForm.TipoVinculo == TipoVinculo.Terceiro && !UsuarioForm.DataValidadeAcesso.HasValue)
            UsuarioForm.DataValidadeAcesso = DataLimiteValidade;
    }

    // Validade do treinamento = data do treinamento + 2 anos (mesma regra para Funcionário e Parceiro).
    private const int AnosValidadeTreinamento = 2;
    private void OnDataTreinamentoChanged()
    {
        UsuarioForm.DataValidadeTreinamento = UsuarioForm.DataTreinamento?.AddYears(AnosValidadeTreinamento);
    }

    private IEnumerable<PerfilUsuario> PerfisDisponiveis =>
        PerfilLogado switch
        {
            PerfilUsuario.SuperGestor => Enum.GetValues(typeof(PerfilUsuario)).Cast<PerfilUsuario>(),
            // Administrador pode cadastrar a equipe operacional da planta: Usuario, Lider de Bloqueio, Comando Central e Administrador
            PerfilUsuario.Administrador => new[] { PerfilUsuario.Usuario, PerfilUsuario.UsuarioFinal, PerfilUsuario.ComandoCentral, PerfilUsuario.Administrador },
            _ => new[] { PerfilUsuario.Usuario }
        };

    private List<UsuarioViewModel> UsuariosFiltrados =>
        string.IsNullOrWhiteSpace(TermoPesquisa)
            ? TodosUsuarios
            : TodosUsuarios
                .Where(u =>
                    (u.Login ?? "").Contains(TermoPesquisa, StringComparison.OrdinalIgnoreCase) ||
                    (u.NomeCompleto ?? "").Contains(TermoPesquisa, StringComparison.OrdinalIgnoreCase) ||
                    DescreverPerfis(u.Perfis, u.Perfil).Contains(TermoPesquisa, StringComparison.OrdinalIgnoreCase) ||
                    DescreverVinculo(u).Contains(TermoPesquisa, StringComparison.OrdinalIgnoreCase) ||
                    ObterNomesPlantas(u.PlantasIds).Any(p => p.Contains(TermoPesquisa, StringComparison.OrdinalIgnoreCase)))
                .ToList();

    // Texto pesquisável do vínculo: tipo traduzido + empresa (quando Terceiro).
    private string DescreverVinculo(UsuarioViewModel u)
    {
        var tipo = u.TipoVinculo == TipoVinculo.Terceiro
            ? Lang["users.bond_contractor"]
            : Lang["users.bond_employee"];
        return u.TipoVinculo == TipoVinculo.Terceiro && !string.IsNullOrWhiteSpace(u.NomeEmpresa)
            ? $"{tipo} {u.NomeEmpresa}"
            : tipo;
    }

    private IEnumerable<UsuarioViewModel> UsuariosPaginados =>
        UsuariosFiltrados
            .Skip((PaginaAtual - 1) * TamanhoPagina)
            .Take(TamanhoPagina);

    private int TotalPaginas =>
        UsuariosFiltrados.Count == 0
            ? 1
            : (int)Math.Ceiling(UsuariosFiltrados.Count / (double)TamanhoPagina);

    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/restricted", forceLoad: true);
            return;
        }

        if (int.TryParse(user.FindFirst("Perfil")?.Value, out var perfilInt))
            PerfilLogado = (PerfilUsuario)perfilInt;

        // ✅ Obter múltiplas plantas do usuário logado
        var plantasIdsStr = user.Claims
            .Where(c => c.Type == "PlantasIds")
            .Select(c => c.Value)
            .ToList();

        foreach (var idStr in plantasIdsStr)
        {
            if (int.TryParse(idStr, out var plantaId))
            {
                PlantasIdsLogado.Add(plantaId);
            }
        }

        // Fallback para claim única (retrocompat)
        if (!PlantasIdsLogado.Any())
        {
            if (int.TryParse(user.FindFirst("PlantaId")?.Value, out var plantaId))
                PlantasIdsLogado.Add(plantaId);
        }

        if (int.TryParse(user.FindFirst("UserId")?.Value, out var userId))
            UsuarioIdLogado = userId;

        try
        {
            await CarregarPlantasAsync();
            await CarregarUsuariosAsync();

            UsuarioForm = CriarNovoUsuarioForm();
            IsEditMode = false;
            UsuarioEmEdicaoId = null;
        }
        finally
        {
            Carregando = false;
        }
    }

    private UsuarioViewModel CriarNovoUsuarioForm()
    {
        var vm = new UsuarioViewModel();

        // Perfil default = Usuario (sempre disponível).
        vm.Perfis = new List<PerfilUsuario> { PerfilUsuario.Usuario };
        vm.Perfil = PerfilUsuario.Usuario;

        // ✅ Administrador pré-seleciona todas as suas plantas
        if (PerfilLogado != PerfilUsuario.SuperGestor && PlantasIdsLogado.Any())
        {
            vm.PlantasIds.AddRange(PlantasIdsLogado);
        }

        return vm;
    }

    private void TogglePerfil(PerfilUsuario perfil, bool selecionado)
    {
        if (selecionado)
        {
            // Regra SuperGestor exclusivo: marcar SuperGestor limpa os demais; marcar outro com SuperGestor já selecionado também é ignorado pela UI (checkbox vem disabled).
            if (perfil == PerfilUsuario.SuperGestor)
            {
                UsuarioForm.Perfis.Clear();
            }
            else
            {
                UsuarioForm.Perfis.Remove(PerfilUsuario.SuperGestor);
            }

            if (!UsuarioForm.Perfis.Contains(perfil))
                UsuarioForm.Perfis.Add(perfil);
        }
        else
        {
            UsuarioForm.Perfis.Remove(perfil);
        }

        // Sincroniza campo legado Perfil (primário): SuperGestor > primeiro.
        UsuarioForm.Perfil = UsuarioForm.Perfis.Contains(PerfilUsuario.SuperGestor)
            ? PerfilUsuario.SuperGestor
            : (UsuarioForm.Perfis.FirstOrDefault() == default ? PerfilUsuario.Usuario : UsuarioForm.Perfis[0]);

        StateHasChanged();
    }

    private async Task CarregarPlantasAsync()
    {
        var dtos = await PlantaService.ListarAsync();

        if (PerfilLogado == PerfilUsuario.SuperGestor)
        {
            Plantas = dtos.ToList();
        }
        else if (PlantasIdsLogado.Any())
        {
            // ✅ Carregar apenas plantas do administrador
            Plantas = dtos.Where(p => PlantasIdsLogado.Contains(p.Id)).ToList();
        }
        else
        {
            Plantas = dtos.ToList();
        }
    }

    private async Task CarregarUsuariosAsync()
    {
        var dtos = await UsuarioService.ListarAsync();

        if (PerfilLogado == PerfilUsuario.SuperGestor)
        {
            // SuperGestor vê todos
        }
        else if (PerfilLogado == PerfilUsuario.Administrador)
        {
            // Admin enxerga apenas usuários cujos perfis incluem Usuario OU Administrador
            // (qualquer um dos perfis basta — multi-perfil, #1c) e que pertençam às suas plantas.
            var perfisAdminVisiveis = new HashSet<int>
            {
                (int)PerfilUsuario.Usuario,
                (int)PerfilUsuario.Administrador
            };

            dtos = dtos
                .Where(u =>
                    (u.Perfis.Any(p => perfisAdminVisiveis.Contains(p))
                        || perfisAdminVisiveis.Contains(u.Perfil)) &&
                    (u.PlantasIds.Any(p => PlantasIdsLogado.Contains(p)) ||
                     (u.PlantaId.HasValue && PlantasIdsLogado.Contains(u.PlantaId.Value))))
                .ToList();
        }
        else
        {
            if (UsuarioIdLogado.HasValue)
            {
                dtos = dtos.Where(u => u.Id == UsuarioIdLogado.Value).ToList();
            }
            else
            {
                dtos = new List<UsuariosDto>();
            }
        }

        TodosUsuarios = dtos
            .Select(u => new UsuarioViewModel
            {
                Id = u.Id,
                Login = u.Login,
                NomeCompleto = u.NomeCompleto,
                Perfil = (PerfilUsuario)u.Perfil,
                Perfis = (u.Perfis?.Count > 0
                            ? u.Perfis.Select(p => (PerfilUsuario)p)
                            : new[] { (PerfilUsuario)u.Perfil })
                          .Distinct()
                          .ToList(),
                Ativa = u.Ativa,
                PlantaId = u.PlantaId,
                PlantasIds = u.PlantasIds?.Any() == true ? new List<int>(u.PlantasIds) : new List<int>(),
                TreinamentoConcluido = u.TreinamentoConcluido,
                DataTreinamento = u.DataTreinamento,
                DataValidadeTreinamento = u.DataValidadeTreinamento,
                TipoVinculo = (TipoVinculo)u.TipoVinculo,
                NomeEmpresa = u.NomeEmpresa,
                DataValidadeAcesso = u.DataValidadeAcesso,
                CriadoPorNome = u.CriadoPorNome,
                CriadoEm = u.CriadoEm,
                AlteradoPorNome = u.AlteradoPorNome,
                AlteradoEm = u.AlteradoEm
            })
            .ToList();

        PaginaAtual = 1;
    }

    private void TogglePlanta(int plantaId, bool selecionada)
    {
        if (selecionada)
        {
            if (!UsuarioForm.PlantasIds.Contains(plantaId))
                UsuarioForm.PlantasIds.Add(plantaId);
        }
        else
        {
            UsuarioForm.PlantasIds.Remove(plantaId);
        }

        StateHasChanged();
    }

    private async Task ShowToastSucessoAsync(string mensagem)
        => await Js.InvokeVoidAsync("adminlteToasts.show", "success", Lang["common.success"], mensagem);

    private async Task ShowToastErroAsync(string mensagem)
        => await Js.InvokeVoidAsync("adminlteToasts.show", "error", Lang["common.error"], mensagem);

    private async Task SalvarUsuarioAsync()
    {
        var isEdicao = IsEditMode && UsuarioEmEdicaoId.HasValue;
        var loginNormalizado = (UsuarioForm.Login ?? string.Empty).Trim();

        if (string.IsNullOrWhiteSpace(loginNormalizado))
        {
            await ShowToastErroAsync(Lang["users.toast.login_required"]);
            return;
        }

        if (!UsuarioForm.Perfis.Any())
        {
            await ShowToastErroAsync(Lang["users.toast.profile_required"]);
            return;
        }

        if (UsuarioForm.Perfis.Contains(PerfilUsuario.SuperGestor) && UsuarioForm.Perfis.Count > 1)
        {
            await ShowToastErroAsync(Lang["users.toast.profile_super_exclusive"]);
            return;
        }

        if (PerfilLogado != PerfilUsuario.SuperGestor &&
            UsuarioForm.Perfis.Contains(PerfilUsuario.SuperGestor))
        {
            await ShowToastErroAsync(Lang["users.toast.only_super"]);
            return;
        }

        if (!UsuarioForm.Perfis.Contains(PerfilUsuario.SuperGestor) && !UsuarioForm.PlantasIds.Any())
        {
            await ShowToastErroAsync(Lang["users.toast.select_plant"]);
            return;
        }

        // #2: regra de Terceiro — empresa e validade obrigatórios.
        if (UsuarioForm.TipoVinculo == TipoVinculo.Terceiro)
        {
            if (string.IsNullOrWhiteSpace(UsuarioForm.NomeEmpresa))
            {
                await ShowToastErroAsync(Lang["users.toast.company_required"]);
                return;
            }
            if (!UsuarioForm.DataValidadeAcesso.HasValue)
            {
                await ShowToastErroAsync(Lang["users.toast.validity_required"]);
                return;
            }
            if (UsuarioForm.DataValidadeAcesso.Value.Date > DataLimiteValidade)
            {
                await ShowToastErroAsync(Lang["users.toast.validity_max_6m"]);
                return;
            }
        }

        // ✅ Validação: Administrador só pode associar às suas plantas
        if (PerfilLogado == PerfilUsuario.Administrador && PlantasIdsLogado.Any())
        {
            if (UsuarioForm.PlantasIds.Any(p => !PlantasIdsLogado.Contains(p)))
            {
                await ShowToastErroAsync(Lang["users.toast.own_plants_only"]);
                return;
            }
        }

        var idAtual = isEdicao ? UsuarioEmEdicaoId!.Value : 0;
        var existeDuplicado = TodosUsuarios.Any(u =>
            u.Id != idAtual &&
            string.Equals((u.Login ?? string.Empty).Trim(), loginNormalizado, StringComparison.OrdinalIgnoreCase) &&
            u.PlantasIds.Any(p => UsuarioForm.PlantasIds.Contains(p)));

        if (existeDuplicado)
        {
            await ShowToastErroAsync(Lang["users.toast.duplicate"]);
            return;
        }

        try
        {
            Salvando = true;
            var dto = new UsuariosDto
            {
                Id = isEdicao ? UsuarioEmEdicaoId.Value : 0,
                Login = loginNormalizado,
                NomeCompleto = UsuarioForm.NomeCompleto,
                Perfil = (int)UsuarioForm.Perfil,
                Perfis = UsuarioForm.Perfis.Select(p => (int)p).ToList(),
                Ativa = UsuarioForm.Ativa,
                PlantaId = UsuarioForm.PlantaId,
                PlantasIds = new List<int>(UsuarioForm.PlantasIds),
                TreinamentoConcluido = UsuarioForm.TreinamentoConcluido,
                DataTreinamento = UsuarioForm.DataTreinamento,
                DataValidadeTreinamento = UsuarioForm.TreinamentoConcluido ? UsuarioForm.DataValidadeTreinamento : null,
                TipoVinculo = (int)UsuarioForm.TipoVinculo,
                NomeEmpresa = UsuarioForm.TipoVinculo == TipoVinculo.Terceiro ? UsuarioForm.NomeEmpresa : null,
                DataValidadeAcesso = UsuarioForm.TipoVinculo == TipoVinculo.Terceiro ? UsuarioForm.DataValidadeAcesso : null,
                Senha = !string.IsNullOrWhiteSpace(UsuarioForm.Senha) ? UsuarioForm.Senha : string.Empty,
                ExecutadoPorId = UsuarioIdLogado
            };

            if (isEdicao)
                await UsuarioService.AtualizarAsync(dto);
            else
                await UsuarioService.CriarAsync(dto);

            UsuarioForm = CriarNovoUsuarioForm();
            IsEditMode = false;
            UsuarioEmEdicaoId = null;

            await CarregarUsuariosAsync();

            await ShowToastSucessoAsync(isEdicao
                ? Lang["users.toast.saved"]
                : Lang["users.toast.registered"]);
        }
        catch (Exception ex)
        {
            await ShowToastErroAsync(Lang["users.toast.save_error"]);
            Console.WriteLine(ex);
        }
        finally
        {
            Salvando = false;
        }
    }

    private async Task IniciarEdicao(int id)
    {
        var usuario = TodosUsuarios.FirstOrDefault(u => u.Id == id);
        if (usuario is null) return;

        if (PerfilLogado == PerfilUsuario.Administrador &&
            (usuario.Perfis.Contains(PerfilUsuario.Administrador) || usuario.Perfis.Contains(PerfilUsuario.SuperGestor)))
        {
            await ShowToastErroAsync(Lang["users.toast.no_permission"]);
            return;
        }

        if (PerfilLogado == PerfilUsuario.Usuario && UsuarioIdLogado.HasValue && usuario.Id != UsuarioIdLogado.Value)
        {
            await ShowToastErroAsync(Lang["users.toast.no_permission"]);
            return;
        }

        IsEditMode = true;
        UsuarioEmEdicaoId = id;

        UsuarioForm = new UsuarioViewModel
        {
            Id = usuario.Id,
            Login = usuario.Login,
            NomeCompleto = usuario.NomeCompleto,
            Perfil = usuario.Perfil,
            Perfis = new List<PerfilUsuario>(usuario.Perfis),
            Ativa = usuario.Ativa,
            PlantaId = usuario.PlantaId,
            PlantasIds = new List<int>(usuario.PlantasIds),
            TreinamentoConcluido = usuario.TreinamentoConcluido,
            DataTreinamento = usuario.DataTreinamento,
            DataValidadeTreinamento = usuario.DataValidadeTreinamento,
            TipoVinculo = usuario.TipoVinculo,
            NomeEmpresa = usuario.NomeEmpresa,
            DataValidadeAcesso = usuario.DataValidadeAcesso,
            Senha = null,
            CriadoPorNome = usuario.CriadoPorNome,
            CriadoEm = usuario.CriadoEm,
            AlteradoPorNome = usuario.AlteradoPorNome,
            AlteradoEm = usuario.AlteradoEm
        };

        StateHasChanged();
    }

    private void AbrirModalExcluir()
    {
        if (!IsEditMode || !UsuarioEmEdicaoId.HasValue)
            return;

        MostrarModalExcluir = true;
    }

    private void FecharModalExcluir()
    {
        MostrarModalExcluir = false;
    }

    private async Task ConfirmarExclusaoAsync()
    {
        if (!IsEditMode || !UsuarioEmEdicaoId.HasValue)
        {
            MostrarModalExcluir = false;
            return;
        }

        try
        {
            Excluindo = true;
            await UsuarioService.RemoverAsync(UsuarioEmEdicaoId.Value);

            UsuarioForm = CriarNovoUsuarioForm();
            IsEditMode = false;
            UsuarioEmEdicaoId = null;

            await CarregarUsuariosAsync();

            await ShowToastSucessoAsync(Lang["users.toast.deleted"]);
        }
        catch (Exception ex)
        {
            await ShowToastErroAsync(Lang["users.toast.delete_error"]);
            Console.WriteLine(ex);
        }
        finally
        {
            Excluindo = false;
            MostrarModalExcluir = false;
        }
    }

    private void CancelarEdicao()
    {
        IsEditMode = false;
        UsuarioEmEdicaoId = null;
        UsuarioForm = CriarNovoUsuarioForm();
    }

    private void LimparPesquisa()
    {
        TermoPesquisa = string.Empty;
        PaginaAtual = 1;
    }

    private void PaginaAnterior()
    {
        if (PaginaAtual > 1)
            PaginaAtual--;
    }

    private void ProximaPagina()
    {
        if (PaginaAtual < TotalPaginas)
            PaginaAtual++;
    }

    private void IrParaPagina(int pagina)
    {
        if (pagina >= 1 && pagina <= TotalPaginas)
            PaginaAtual = pagina;
    }

    private List<int?> GetPaginasVisiveis()
    {
        var paginas = new List<int?>();
        const int delta = 2;

        if (TotalPaginas <= 7)
        {
            for (int i = 1; i <= TotalPaginas; i++)
            {
                paginas.Add(i);
            }
        }
        else
        {
            paginas.Add(1);

            int start = Math.Max(2, PaginaAtual - delta);
            int end = Math.Min(TotalPaginas - 1, PaginaAtual + delta);

            if (start > 2)
            {
                paginas.Add(null);
            }

            for (int i = start; i <= end; i++)
            {
                paginas.Add(i);
            }

            if (end < TotalPaginas - 1)
            {
                paginas.Add(null);
            }

            paginas.Add(TotalPaginas);
        }

        return paginas;
    }

    private string GetPerfilDescricao(PerfilUsuario perfil) =>
        perfil switch
        {
            PerfilUsuario.Usuario => Lang["users.profile_user"],
            PerfilUsuario.Administrador => Lang["users.profile_admin"],
            PerfilUsuario.SuperGestor => Lang["users.profile_super"],
            PerfilUsuario.UsuarioFinal => Lang["users.profile_final"],
            PerfilUsuario.ComandoCentral => Lang["users.profile_central"],
            _ => perfil.ToString()
        };

    private string DescreverPerfis(List<PerfilUsuario> perfis, PerfilUsuario fallback)
    {
        if (perfis is null || perfis.Count == 0)
            return GetPerfilDescricao(fallback);

        return string.Join(", ", perfis.Distinct().Select(GetPerfilDescricao));
    }

    // #2: status de validade do acesso para destaque visual.
    private static StatusValidadeAcesso ObterStatusValidade(DateTime? dataValidade)
        => VinculoValidacao.AvaliarStatus(dataValidade);

    private static string BadgeClass(StatusValidadeAcesso status) => status switch
    {
        StatusValidadeAcesso.Vencido => "bg-danger text-white",
        StatusValidadeAcesso.Vencendo => "bg-warning text-dark",
        StatusValidadeAcesso.Vigente => "bg-success text-white",
        _ => "bg-secondary text-white"
    };

    // #3: agrega status (acesso + treinamento). Vencido > Vencendo > Vigente > SemValidade.
    private static StatusValidadeAcesso PiorStatus(StatusValidadeAcesso a, StatusValidadeAcesso b)
        => (StatusValidadeAcesso)Math.Max((int)a, (int)b);

    private void SelecionarLinha(int id)
    {
        LinhaSelecionadaId = LinhaSelecionadaId == id ? null : id;
    }

    private string MontarClasseLinha(int id, StatusValidadeAcesso status)
    {
        var classes = new List<string>();
        if (LinhaSelecionadaId == id) classes.Add("row-selected");
        if (status == StatusValidadeAcesso.Vencido) classes.Add("table-danger");
        else if (status == StatusValidadeAcesso.Vencendo) classes.Add("table-warning");
        return string.Join(" ", classes);
    }

    private string? GetNomePlanta(int? plantaId)
    {
        if (plantaId is null) return null;
        var p = Plantas.FirstOrDefault(x => x.Id == plantaId.Value);
        return p != null ? $"{p.Nome} ({p.Codigo})" : null;
    }

    private IEnumerable<string> ObterNomesPlantas(List<int> plantasIds)
    {
        return plantasIds
            .Select(id => {
                var planta = Plantas.FirstOrDefault(p => p.Id == id);
                return planta != null ? $"{planta.Nome} ({planta.Codigo})" : null;
            })
            .Where(nome => !string.IsNullOrEmpty(nome))
            .Cast<string>();
    }
