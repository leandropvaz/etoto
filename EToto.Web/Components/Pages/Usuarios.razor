@page "/usuarios"
@using System.ComponentModel.DataAnnotations
@using EToto.Domain.Enums
@using Microsoft.AspNetCore.Components.Authorization
@using EToto.Application.Dto
@using EToto.Web.Services
@inject UsuariosService UsuarioService
@inject PlantasService PlantaService
@inject IJSRuntime Js
@inject LanguageService Lang
@layout MainLayout
@inject NavigationManager Nav
@implements IDisposable

<section class="content pt-3">
    <div class="container-fluid">

        @* Toolbox: sub-abas que consolidam Cadastro, Revalidação, Auditoria e Relatórios numa só página *@
        <div class="usuarios-toolbox card card-outline card-primary mb-3">
            <ul class="nav nav-pills p-2 mb-0">
                <li class="nav-item mr-1">
                    <button type="button" class="nav-link @(SecaoAtiva == Secao.Cadastro ? "active" : "")"
                            @onclick="() => SecaoAtiva = Secao.Cadastro">
                        <i class="fas fa-user-edit mr-1"></i>@Lang["users.tab.registration"]
                    </button>
                </li>
                @if (PodeAdministrar)
                {
                    <li class="nav-item mr-1">
                        <button type="button" class="nav-link @(SecaoAtiva == Secao.Revalidacao ? "active" : "")"
                                @onclick="() => SecaoAtiva = Secao.Revalidacao">
                            <i class="fas fa-redo mr-1"></i>@Lang["users.tab.revalidation"]
                        </button>
                    </li>
                    <li class="nav-item mr-1">
                        <button type="button" class="nav-link @(SecaoAtiva == Secao.Auditoria ? "active" : "")"
                                @onclick="() => SecaoAtiva = Secao.Auditoria">
                            <i class="fas fa-history mr-1"></i>@Lang["users.tab.audit"]
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button" class="nav-link @(SecaoAtiva == Secao.Relatorios ? "active" : "")"
                                @onclick="() => SecaoAtiva = Secao.Relatorios">
                            <i class="fas fa-file-export mr-1"></i>@Lang["users.tab.reports"]
                        </button>
                    </li>
                }
            </ul>
        </div>

        @if (SecaoAtiva == Secao.Cadastro)
        {
        <!-- #8: layout empilhado — formulário em cima (largura total), lista embaixo -->
        <div class="row">

            <!-- FORMULÁRIO CADASTRO/EDIÇÃO (full width) -->
            <div class="col-12">
                <div class="card card-primary card-outline mb-3">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-user mr-1"></i>
                            @(IsEditMode ? Lang["users.edit"] : Lang["users.register"])
                        </h3>

                        @if (IsEditMode)
                        {
                            <div class="card-tools">
                                <button type="button"
                                        class="btn btn-tool"
                                        title="@Lang["common.cancel_edit_title"]"
                                        @onclick="CancelarEdicao">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        }
                    </div>

                    <div class="card-body">
                        <EditForm Model="@UsuarioForm" OnValidSubmit="SalvarUsuarioAsync" FormName="UsuarioForm">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger mb-2" />

                            <div class="row">

                            @* COLUNA ESQUERDA: dados básicos + treinamento + vínculo *@
                            <div class="col-12 col-md-6">

                            <!-- Login -->
                            <div class="form-group">
                                <label>@Lang["users.login_field"]</label>
                                <InputText class="form-control" @bind-Value="UsuarioForm.Login" />
                                <ValidationMessage For="@(() => UsuarioForm.Login)" class="text-danger" />
                            </div>

                            <!-- Nome completo -->
                            <div class="form-group">
                                <label>@Lang["users.full_name"]</label>
                                <InputText class="form-control" @bind-Value="UsuarioForm.NomeCompleto" />
                                <ValidationMessage For="@(() => UsuarioForm.NomeCompleto)" class="text-danger" />
                            </div>

                            <!-- Senha -->
                            <div class="form-group">
                                <label>@Lang["users.password"]</label>
                                <InputText class="form-control"
                                           type="password"
                                           @bind-Value="UsuarioForm.Senha" />
                                @if (IsEditMode)
                                {
                                    <small class="form-text text-muted">
                                        @Lang["users.password_hint"]
                                    </small>
                                }
                                <ValidationMessage For="@(() => UsuarioForm.Senha)" class="text-danger" />
                            </div>

                            <!-- Perfis (múltiplos, #1c) -->
                            <div class="form-group">
                                <label>@Lang["users.access_profiles"]</label>
                                <div class="perfis-checkboxes">
                                    @foreach (var value in PerfisDisponiveis)
                                    {
                                        var isChecked = UsuarioForm.Perfis.Contains(value);
                                        var isSuper = value == PerfilUsuario.SuperGestor;
                                        var temOutroSelecionado = UsuarioForm.Perfis.Any(p => p != PerfilUsuario.SuperGestor);
                                        var temSuperSelecionado = UsuarioForm.Perfis.Contains(PerfilUsuario.SuperGestor);
                                        // Desabilita conforme regra "SuperGestor exclusivo":
                                        // - SuperGestor desabilita quando há outro perfil selecionado
                                        // - Outros perfis desabilitam quando SuperGestor já está selecionado
                                        var isDisabled = (isSuper && temOutroSelecionado && !isChecked)
                                                         || (!isSuper && temSuperSelecionado && !isChecked);

                                        <div class="form-check">
                                            <input type="checkbox"
                                                   class="form-check-input"
                                                   id="perfil_@value"
                                                   checked="@isChecked"
                                                   disabled="@isDisabled"
                                                   @onchange="@(e => TogglePerfil(value, (bool)e.Value!))" />
                                            <label class="form-check-label @(isDisabled ? "text-muted" : "")" for="perfil_@value">
                                                @GetPerfilDescricao(value)
                                            </label>
                                        </div>
                                    }
                                </div>
                                @if (!UsuarioForm.Perfis.Any())
                                {
                                    <small class="text-danger">@Lang["users.toast.profile_required"]</small>
                                }
                                else if (UsuarioForm.Perfis.Contains(PerfilUsuario.SuperGestor) && UsuarioForm.Perfis.Count > 1)
                                {
                                    <small class="text-danger">@Lang["users.profile_super_exclusive"]</small>
                                }
                            </div>

                            <!-- Treinamento LOTOTO -->
                            <div class="form-group">
                                <div class="custom-control custom-checkbox">
                                    <input type="checkbox" class="custom-control-input" id="chkTreinamento"
                                           @bind="UsuarioForm.TreinamentoConcluido" />
                                    <label class="custom-control-label" for="chkTreinamento">@Lang["users.training_completed"]</label>
                                </div>
                                @if (UsuarioForm.TreinamentoConcluido)
                                {
                                    <input type="date" class="form-control mt-1"
                                           @bind="UsuarioForm.DataTreinamento"
                                           @bind:after="OnDataTreinamentoChanged" />
                                    <label class="mt-2">@Lang["users.training_validity"]</label>
                                    <input type="date" class="form-control" @bind="UsuarioForm.DataValidadeTreinamento" />
                                    <small class="form-text text-muted">@Lang["users.training_validity_hint"]</small>
                                }
                            </div>

                            <!-- Vínculo Funcionário/Terceiro (#2) -->
                            <div class="form-group">
                                <label>@Lang["users.bond_type"]</label>
                                <InputSelect class="form-control" @bind-Value="UsuarioForm.TipoVinculo"
                                             @bind-Value:after="OnTipoVinculoChanged">
                                    <option value="@TipoVinculo.Funcionario">@Lang["users.bond_employee"]</option>
                                    <option value="@TipoVinculo.Terceiro">@Lang["users.bond_contractor"]</option>
                                </InputSelect>
                            </div>

                            @if (UsuarioForm.TipoVinculo == TipoVinculo.Terceiro)
                            {
                                <div class="form-group">
                                    <label>@Lang["users.company_name"]</label>
                                    <InputText class="form-control" @bind-Value="UsuarioForm.NomeEmpresa" />
                                    @if (string.IsNullOrWhiteSpace(UsuarioForm.NomeEmpresa))
                                    {
                                        <small class="text-danger">@Lang["users.toast.company_required"]</small>
                                    }
                                </div>
                                <div class="form-group">
                                    <label>@Lang["users.access_validity"]</label>
                                    <input type="date" class="form-control"
                                           min="@DataMinValidade" max="@DataMaxValidade"
                                           @bind="UsuarioForm.DataValidadeAcesso" />
                                    <small class="form-text text-muted">@Lang["users.access_validity_hint"]</small>
                                    @if (!UsuarioForm.DataValidadeAcesso.HasValue)
                                    {
                                        <small class="text-danger">@Lang["users.toast.validity_required"]</small>
                                    }
                                    else if (UsuarioForm.DataValidadeAcesso.Value.Date > DataLimiteValidade)
                                    {
                                        <small class="text-danger">@Lang["users.toast.validity_max_6m"]</small>
                                    }
                                </div>
                            }

                            </div> @* fim col esquerda *@

                            @* COLUNA DIREITA: plantas + status + auditoria *@
                            <div class="col-12 col-md-6">

                            <!-- Plantas (múltiplas) - só se NÃO houver SuperGestor entre os perfis -->
                            @if (!UsuarioForm.Perfis.Contains(PerfilUsuario.SuperGestor))
                            {
                                <div class="form-group">
                                    <label>@Lang["users.plants_select"]</label>
                                    @if (PerfilLogado == PerfilUsuario.Administrador && PlantasIdsLogado.Any())
                                    {
                                        <small class="form-text text-info mb-1">
                                            <i class="fas fa-info-circle"></i> @Lang["users.admin_restriction"]
                                        </small>
                                    }
                                    <div class="plantas-checkboxes">
                                        @foreach (var planta in Plantas)
                                        {
                                            var isChecked = UsuarioForm.PlantasIds.Contains(planta.Id);
                                            // Administrador só pode gerenciar suas próprias plantas
                                            var isDisabled = PerfilLogado == PerfilUsuario.Administrador &&
                                            !PlantasIdsLogado.Contains(planta.Id);

                                            <div class="form-check">
                                                <input type="checkbox"
                                                       class="form-check-input"
                                                       id="planta_@planta.Id"
                                                       checked="@isChecked"
                                                       disabled="@isDisabled"
                                                       @onchange="@(e => TogglePlanta(planta.Id, (bool)e.Value!))" />
                                                <label class="form-check-label @(isDisabled ? "text-muted" : "")" for="planta_@planta.Id">
                                                    @planta.Nome (@planta.Codigo)
                                                </label>
                                            </div>
                                        }
                                    </div>
                                    @if (!UsuarioForm.PlantasIds.Any())
                                    {
                                        <small class="text-danger">@Lang["users.select_plant_required"]</small>
                                    }
                                </div>
                            }

                            <!-- Ativo -->
                            <div class="form-group">
                                <div class="icheck-primary d-inline">
                                    <InputCheckbox id="usuarioAtivo"
                                                   class="form-check-input"
                                                   @bind-Value="UsuarioForm.Ativa" />
                                    <label for="usuarioAtivo">@Lang["users.active"]</label>
                                </div>
                            </div>

                            </div> @* fim col direita *@
                            </div> @* fim row interno *@

                            <div class="d-flex justify-content-between">
                                <button type="submit" class="btn btn-primary" disabled="@Salvando">
                                    @if (Salvando)
                                    {
                                        <span><i class="fas fa-sync-alt fa-spin mr-1"></i>@Lang["common.processing"]</span>
                                    }
                                    else
                                    {
                                        @(IsEditMode ? Lang["common.save"] : Lang["common.register"])
                                    }
                                </button>

                                @if (IsEditMode)
                                {
                                    <button type="button"
                                            class="btn btn-danger"
                                            disabled="@(Salvando || Excluindo)"
                                            @onclick="AbrirModalExcluir">
                                        <i class="fas fa-trash-alt mr-1"></i> @Lang["common.delete"]
                                    </button>
                                }
                            </div>

                            @* Auditoria de cadastro (#1c) — só em modo edição *@
                            @if (IsEditMode && (UsuarioForm.CriadoEm.HasValue || UsuarioForm.AlteradoEm.HasValue))
                            {
                                <div class="audit-panel mt-3">
                                    <small class="text-muted d-block mb-1"><strong>@Lang["users.audit_title"]</strong></small>
                                    @if (UsuarioForm.CriadoEm.HasValue)
                                    {
                                        <small class="text-muted d-block">
                                            <i class="fas fa-plus-circle mr-1"></i>
                                            @Lang["users.created_by"]:
                                            <strong>@(UsuarioForm.CriadoPorNome ?? Lang["users.audit_unknown"])</strong>
                                            @Lang["users.audit_at"] @UsuarioForm.CriadoEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    }
                                    @if (UsuarioForm.AlteradoEm.HasValue)
                                    {
                                        <small class="text-muted d-block">
                                            <i class="fas fa-pencil-alt mr-1"></i>
                                            @Lang["users.updated_by"]:
                                            <strong>@(UsuarioForm.AlteradoPorNome ?? Lang["users.audit_unknown"])</strong>
                                            @Lang["users.audit_at"] @UsuarioForm.AlteradoEm.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    }
                                </div>
                            }
                        </EditForm>
                    </div>
                </div>
            </div>

            <!-- LISTA PAGINADA (full width, abaixo do formulário) -->
            <div class="col-12">

                <div class="card card-info card-outline mb-3">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-users mr-1"></i>
                            @Lang["users.search"]
                        </h3>

                        <div class="card-tools">
                            <div class="input-group input-group-sm" style="width: 260px;">
                                <input type="text"
                                       name="table_search"
                                       class="form-control float-right"
                                       placeholder="@Lang["users.search_placeholder"]"
                                       @bind="TermoPesquisa"
                                       @bind:event="oninput" />

                                <div class="input-group-append">
                                    <button type="button"
                                            class="btn btn-default"
                                            title="@Lang["common.clear"]"
                                            @onclick="LimparPesquisa">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-2">

                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
                            <div>
                                <small class="text-muted">
                                    @if (UsuariosFiltrados?.Any() == true)
                                    {
                                        @($"{UsuariosFiltrados.Count} {Lang["users.found"]}")
                                    }
                                    else
                                    {
                                        @Lang["users.not_found"]
                                    }
                                </small>
                            </div>

                            <div class="btn-group btn-group-sm">
                                <select class="form-control form-control-sm ml-2"
                                        style="width: 80px;"
                                        @bind="TamanhoPagina">
                                    <option value="5">5</option>
                                    <option value="10">10</option>
                                    <option value="20">20</option>
                                </select>
                            </div>
                        </div>

                        <div class="table-responsive pw-table-cards">
                            <table class="table table-bordered table-hover table-sm mb-0 usuarios-table selectable-table">
                                <thead class="thead-light">
                                    <tr>
                                        <th style="width: 11%;">@Lang["users.col_login"]</th>
                                        <th style="width: 16%;">@Lang["users.col_name"]</th>
                                        <th style="width: 10%;">@Lang["users.col_profiles"]</th>
                                        <th style="width: 11%;">@Lang["users.col_bond"]</th>
                                        <th style="width: 11%;">@Lang["users.col_training"]</th>
                                        <th style="width: 19%;">@Lang["users.col_plants"]</th>
                                        <th style="width: 8%;" class="text-center">@Lang["users.col_active"]</th>
                                        <th style="width: 12%;" class="text-center">@Lang["common.actions"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Carregando)
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center text-muted py-3">
                                                <i class="fas fa-sync-alt fa-spin mr-2"></i>@Lang["common.loading"]
                                            </td>
                                        </tr>
                                    }
                                    else if (UsuariosPaginados.Any())
                                    {
                                        @foreach (var u in UsuariosPaginados)
                                        {
                                            var statusValidade = ObterStatusValidade(u.DataValidadeAcesso);
                                            var statusTreinamento = ObterStatusValidade(u.DataValidadeTreinamento);
                                            var exigeTreinamento = TreinamentoValidacao.AlgumPerfilExigeTreinamento(
                                                u.Perfis.Select(p => (EToto.Domain.Enums.PerfilUsuario)(int)p));
                                            // Linha em vermelho/amarelo se acesso OU treinamento (quando exigido) estiver no pior estado.
                                            var statusPiorLinha = PiorStatus(statusValidade,
                                                exigeTreinamento ? statusTreinamento : StatusValidadeAcesso.SemValidade);
                                            <tr class="@MontarClasseLinha(u.Id, statusPiorLinha)" @onclick="() => SelecionarLinha(u.Id)">
                                                <td data-label="@(Lang["users.col_login"])">@u.Login</td>
                                                <td data-label="@(Lang["users.col_name"])">@u.NomeCompleto</td>
                                                <td data-label="@(Lang["users.col_profiles"])">@DescreverPerfis(u.Perfis, u.Perfil)</td>
                                                <td data-label="@(Lang["users.col_bond"])">
                                                    @if (u.TipoVinculo == TipoVinculo.Terceiro)
                                                    {
                                                        <div><strong>@Lang["users.bond_contractor"]</strong></div>
                                                        @if (!string.IsNullOrWhiteSpace(u.NomeEmpresa))
                                                        {
                                                            <div class="text-muted small">@u.NomeEmpresa</div>
                                                        }
                                                        @if (u.DataValidadeAcesso.HasValue)
                                                        {
                                                            <span class="badge @BadgeClass(statusValidade) badge-sm">
                                                                @u.DataValidadeAcesso.Value.ToLocalTime().ToString("dd/MM/yyyy")
                                                                @if (statusValidade == StatusValidadeAcesso.Vencido)
                                                                { <span>· @Lang["users.validity_expired"]</span> }
                                                                else if (statusValidade == StatusValidadeAcesso.Vencendo)
                                                                { <span>· @Lang["users.validity_expiring"]</span> }
                                                            </span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">@Lang["users.bond_employee"]</span>
                                                    }
                                                </td>
                                                <td data-label="@(Lang["users.col_training"])">
                                                    @if (!exigeTreinamento)
                                                    {
                                                        <span class="text-muted small">@Lang["users.training_not_required"]</span>
                                                    }
                                                    else if (!u.TreinamentoConcluido)
                                                    {
                                                        <span class="badge bg-secondary badge-sm">@Lang["users.training_completed"]: —</span>
                                                    }
                                                    else if (u.DataValidadeTreinamento.HasValue)
                                                    {
                                                        <span class="badge @BadgeClass(statusTreinamento) badge-sm">
                                                            @u.DataValidadeTreinamento.Value.ToLocalTime().ToString("dd/MM/yyyy")
                                                            @if (statusTreinamento == StatusValidadeAcesso.Vencido)
                                                            { <span>· @Lang["users.validity_expired"]</span> }
                                                            else if (statusTreinamento == StatusValidadeAcesso.Vencendo)
                                                            { <span>· @Lang["users.validity_expiring"]</span> }
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark badge-sm">
                                                            <i class="fas fa-exclamation-triangle mr-1"></i>@Lang["users.training_validity"]
                                                        </span>
                                                    }
                                                </td>
                                                <td data-label="@(Lang["users.col_plants"])">
                                                    @if (u.Perfis.Contains(PerfilUsuario.SuperGestor))
                                                    {
                                                        <span class="text-muted">@Lang["users.all_plants"]</span>
                                                    }
                                                    else if (u.PlantasIds.Any())
                                                    {
                                                        <span>@string.Join(", ", ObterNomesPlantas(u.PlantasIds))</span>
                                                    }
                                                    else if (u.PlantaId.HasValue)
                                                    {
                                                        <span>@GetNomePlanta(u.PlantaId)</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">@Lang["users.no_plant"]</span>
                                                    }
                                                </td>
                                                <td data-label="@(Lang["users.col_active"])" class="text-center">
                                                    @if (u.Ativa)
                                                    {
                                                        <span class="badge bg-success badge-sm">@Lang["common.active"]</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary badge-sm">@Lang["common.inactive"]</span>
                                                    }
                                                </td>
                                                <td data-label="@(Lang["common.actions"])" class="text-center">
                                                    <button class="btn btn-xs btn-outline-primary"
                                                            title="@Lang["common.edit"]"
                                                            @onclick="() => IniciarEdicao(u.Id)">
                                                        <i class="fas fa-edit"></i> @Lang["common.edit"]
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center text-muted py-3">
                                                @Lang["users.no_records"]
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>

                    <div class="card-footer clearfix">
                        <span class="text-muted">
                            @Lang["common.page"] @PaginaAtual @Lang["common.of"] @TotalPaginas
                        </span>

                        <ul class="pagination pagination-sm m-0 float-right">
                            <li class="page-item @(PaginaAtual == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="PaginaAnterior">«</button>
                            </li>

                            @foreach (var pagina in GetPaginasVisiveis())
                            {
                                @if (pagina.HasValue)
                                {
                                    <li class="page-item @(PaginaAtual == pagina.Value ? "active" : "")">
                                        <button class="page-link" @onclick="() => IrParaPagina(pagina.Value)">@pagina.Value</button>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }

                            <li class="page-item @(PaginaAtual == TotalPaginas ? "disabled" : "")">
                                <button class="page-link" @onclick="ProximaPagina">»</button>
                            </li>
                        </ul>
                    </div>
                </div>

            </div>

        </div>

        @* MODAL DE CONFIRMAÇÃO DE EXCLUSÃO *@
        @if (MostrarModalExcluir)
        {
            <div class="modal fade show"
                 tabindex="-1"
                 role="dialog"
                 style="display:block;"
                 aria-modal="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content confirm-modal">
                        <div class="modal-header bg-danger text-white">
                            <h5 class="modal-title mb-0">
                                <i class="fas fa-exclamation-triangle mr-2"></i>
                                @Lang["common.confirm_delete"]
                            </h5>
                            <button type="button"
                                    class="close text-white"
                                    aria-label="Close"
                                    @onclick="FecharModalExcluir">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-2">
                                @Lang["users.delete_confirm_text"]
                                <strong>@UsuarioForm.Login</strong>?
                            </p>
                        </div>
                        <div class="modal-footer d-flex justify-content-between">
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    disabled="@Excluindo"
                                    @onclick="FecharModalExcluir">
                                <i class="fas fa-times mr-1"></i> @Lang["common.no"]
                            </button>
                            <button type="button"
                                    class="btn btn-danger btn-sm"
                                    disabled="@Excluindo"
                                    @onclick="ConfirmarExclusaoAsync">
                                @if (Excluindo)
                                {
                                    <span><i class="fas fa-sync-alt fa-spin mr-1"></i>@Lang["common.processing"]</span>
                                }
                                else
                                {
                                    <span><i class="fas fa-trash-alt mr-1"></i>@Lang["common.yes_delete"]</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-backdrop fade show"></div>
        }
        }
        else if (SecaoAtiva == Secao.Revalidacao)
        {
            <SecaoRevalidacao />
        }
        else if (SecaoAtiva == Secao.Auditoria)
        {
            <SecaoAuditoria />
        }
        else if (SecaoAtiva == Secao.Relatorios)
        {
            <SecaoRelatorioUsuarios />
        }

    </div>
</section>

