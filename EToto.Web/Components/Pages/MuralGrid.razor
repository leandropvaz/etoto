@using EToto.Application.Dto
@using EToto.Domain.Enums
@using EToto.Web.Services
@inject LanguageService Lang

@* Grade de cards do painel. Compartilhada pela tela /painel (dentro do app) e
   pelo mural de TV (/mural/{codigo}), que só muda a escala. *@

<div class="mural-legend">
    <span class="pw-label mural-legend__title">@Lang["ple.legend"]</span>
    <span class="pw-sig pw-sig--danger">@Lang["ple.status.em_andamento"]</span>
    <span class="pw-sig pw-sig--warn">@Lang["ple.status.inicio_desbloqueio"]</span>
    <span class="pw-sig pw-sig--idle">@Lang["ple.maintenance_badge"]</span>
</div>

@if (Equipamentos is null || Equipamentos.Count == 0)
{
    <div class="pw-empty mural-empty">
        <i class="fas fa-check-circle"></i>
        @Lang["mural.none_blocked"]
    </div>
}
else
{
    <div class="mural-grid">
        @foreach (var e in Equipamentos)
        {
            var info = Info(e);
            var temDetalhe = MostrarDetalhe && e.Requisicoes.Count > 0;
            var clicavel = Clicavel && !e.Livre;

            <div class="mural-card @info.Css @(clicavel ? "is-clicavel" : "")"
                 tabindex="@(clicavel ? "0" : "-1")"
                 @onclick="() => OnCardClick.InvokeAsync(e)">

                <div class="mural-card__head">
                    <span class="mural-icon"><i class="@info.Icon"></i></span>
                    <span class="pw-sig @info.Sig">@info.Label</span>
                </div>

                <div class="mural-tag">@e.Tag</div>
                @if (!string.IsNullOrWhiteSpace(e.Nome))
                {
                    <div class="mural-nome">@e.Nome</div>
                }

                @if (temDetalhe)
                {
                    <div class="mural-detalhe">
                        @foreach (var r in e.Requisicoes)
                        {
                            <div class="mural-req">
                                <span class="mural-req__num pw-num">@r.Numero</span>
                                @if (r.Lideres.Count > 0)
                                {
                                    <span class="mural-req__lead">@string.Join(", ", r.Lideres)</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public List<PainelAlertaEquipamentoDto>? Equipamentos { get; set; }
    [Parameter] public bool MostrarDetalhe { get; set; }
    [Parameter] public bool Clicavel { get; set; }
    [Parameter] public EventCallback<PainelAlertaEquipamentoDto> OnCardClick { get; set; }

    // Mesmo vocabulário de estado da tela /ple: "Em andamento" é PERIGO (há energia
    // isolada com gente trabalhando), não uma cor primária qualquer.
    private (string Css, string Sig, string Icon, string Label) Info(PainelAlertaEquipamentoDto e) => e.Status switch
    {
        StatusPle.EmAndamento       => ("st-andamento",   "pw-sig--danger", "fas fa-lock",           Lang["ple.status.em_andamento"]),
        StatusPle.InicioDesbloqueio => ("st-desbloqueio", "pw-sig--warn",   "fas fa-unlock",         Lang["ple.status.inicio_desbloqueio"]),
        StatusPle.Criado            => ("st-criado",      "pw-sig--idle",   "fas fa-hourglass-half", Lang["ple.maintenance_badge"]),
        _                           => ("st-livre",       "pw-sig--safe",   "fas fa-check-circle",   Lang["mural.state_free"]),
    };
}
