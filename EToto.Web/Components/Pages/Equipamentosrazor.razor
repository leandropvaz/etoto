    private void IrParaPagina(int p) { if (p >= 1 && p <= TotalPaginas) { PaginaAtual = p; StateHasChanged(); } }
    private void ResetarPagina() { PaginaAtual = 1; StateHasChanged(); }

    private List<int?> GetPaginasVisiveis()
    {
        var paginas = new List<int?>();
        const int delta = 2;
        if (TotalPaginas <= 7) { for (int i = 1; i <= TotalPaginas; i++) paginas.Add(i); }
        else
        {
            paginas.Add(1);
            int start = Math.Max(2, PaginaAtual - delta);
            int end = Math.Min(TotalPaginas - 1, PaginaAtual + delta);
            if (start > 2) paginas.Add(null);
            for (int i = start; i <= end; i++) paginas.Add(i);
            if (end < TotalPaginas - 1) paginas.Add(null);
            paginas.Add(TotalPaginas);
        }
        return paginas;
    }

    // ===== ESTILOS ENERGIA =====
    private string GetEstiloTipoEnergia(string? tipoEnergia)
    {
        if (string.IsNullOrWhiteSpace(tipoEnergia)) return string.Empty;
        var tipo = RemoverAcentos(tipoEnergia.Split('/')[0].Trim()).ToUpperInvariant();
        var corFundo = tipo switch
        {
            var t when t.Contains("ELETRICA") || t.Contains("ELETRIC") => "#FF2929",
            var t when t.Contains("GRAVITACIONAL") => "#D4C19C",
            var t when t.Contains("PNEUMATICA") => "#4BDFF3",
            var t when t.Contains("MECANICA") => "#8C8C8C",
            var t when t.Contains("GAS") => "#E9E6D7",
            var t when t.Contains("HIDRAULICA") => "#0041DA",
            var t when t.Contains("QUIMICA") => "#FFC301",
            var t when t.Contains("RADIACAO") => "#FFFF00",
            var t when t.Contains("TERMICA") => "#DAEFF3",
            _ => "transparent"
        };
        if (corFundo == "transparent") return string.Empty;
        var corTexto = corFundo switch { "#FF2929" => "white", "#0041DA" => "white", "#8C8C8C" => "white", _ => "#333" };
        return $"background-color: {corFundo}; color: {corTexto}; font-weight: 600; border-left-color: {corFundo};";
    }

    // ===== UTILITÁRIOS =====
    private static string RemoverAcentos(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return string.Empty;
        var sb = new StringBuilder();
        foreach (var c in texto.Normalize(NormalizationForm.FormD))
            if (CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark) sb.Append(c);
        return sb.ToString().Normalize(NormalizationForm.FormC);
    }

    private static bool ContainsIgnoreCaseAndAccents(string? source, string? value)
    {
        if (string.IsNullOrWhiteSpace(source) || string.IsNullOrWhiteSpace(value)) return false;
        return RemoverAcentos(source).ToUpperInvariant().Contains(RemoverAcentos(value).ToUpperInvariant());
    }

