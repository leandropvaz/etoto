@page "/equipamentos"
@using System.ComponentModel.DataAnnotations
@using System.Drawing
@using System.Drawing.Imaging
@using System.Linq
@using EToto.Application.Dto
@using EToto.Application.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text
@using System.Globalization
@using EToto.Web.Services
@inject PlantasService PlantaService
@inject IEquipamentoAppService EquipamentoAppService
@inject IPleAppService PleService
@inject IJSRuntime Js
@inject NavigationManager Nav
@inject LanguageService Lang
@implements IDisposable

@layout MainLayout

<section class="content pt-3">
    <div class="container-fluid">

        <!-- LINHA 1 – WIZARD -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="card card-primary card-outline">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-cogs mr-1"></i>
                            @(IsEditMode ? Lang["equip.edit"] : Lang["equip.register_import"])
                        </h3>
                        <div class="card-tools">
                            <span class="badge badge-info badge-sm">@Lang["equip.step"] @passoAtual @Lang["equip.of"] 3</span>
                        </div>
                    </div>

                    <div class="card-body">

                        @* PASSO 1 *@
                        @if (passoAtual == 1)
                        {
                            <div class="form-group">
                                <label>@Lang["equip.plant"]</label>
                                <select class="form-control"
                                        @onchange="PlantaAlterada"
                                        disabled="@Importando">
                                    <option value="">@Lang["equip.select_plant"]</option>
                                    @foreach (var p in PlantasDisponiveis)
                                    {
                                        <option value="@p.Id" selected="@(PlantaSelecionadaId == p.Id)">
                                            @p.Nome (@p.Codigo)
                                        </option>
                                    }
                                </select>
                                @if (PlantasDisponiveis.Count == 1)
                                {
                                    <small class="form-text text-muted">
                                        <i class="fas fa-info-circle"></i> @Lang["equip.single_plant_info"]
                                    </small>
                                }
                                else if (PlantasDisponiveis.Count > 1)
                                {
                                    <small class="form-text text-muted">
                                        <i class="fas fa-info-circle"></i> @Lang["equip.multi_plant_info"] @PlantasDisponiveis.Count @Lang["equip.multi_plant_info2"]
                                    </small>
                                }
                            </div>

                            <div class="form-group mt-3">
                                <label>@Lang["equip.operation_mode"]</label>
                                <div class="icheck-primary radio-small">
                                    <input type="radio" id="modoManual" name="modoCadastro"
                                           disabled="@Importando"
                                           checked="@(ModoSelecionado == ModoCadastro.Manual)"
                                           @onchange="() => ModoSelecionado = ModoCadastro.Manual" />
                                    <label for="modoManual">
                                        @Lang["equip.manual_mode"] @(IsEditMode ? Lang["equip.edit_mode_label"] : "")
                                    </label>
                                </div>
                                <div class="icheck-primary radio-small">
                                    <input type="radio" id="modoImportacao" name="modoCadastro"
                                           disabled="@Importando"
                                           checked="@(ModoSelecionado == ModoCadastro.ImportacaoExcel)"
                                           @onchange="() => ModoSelecionado = ModoCadastro.ImportacaoExcel" />
                                    <label for="modoImportacao">
                                        @Lang["equip.import_mode"]
                                    </label>
                                </div>
                            </div>
                        }

                        @* PASSO 2 *@
                        else if (passoAtual == 2)
                        {
                            @if (ModoSelecionado == ModoCadastro.Manual)
                            {
                                <EditForm Model="@Manual" OnValidSubmit="SalvarManual">
                                    <DataAnnotationsValidator />
                                    <ValidationSummary class="text-danger mb-2" />

                                    @* CABEÇALHO *@
                                    <div class="card card-outline card-secondary mb-2">
                                        <div class="card-header py-2">
                                            <h6 class="card-title mb-0">
                                                <i class="fas fa-id-badge mr-1"></i>
                                                @Lang["equip.header"]
                                            </h6>
                                        </div>
                                        <div class="card-body py-2">
                                            <div class="form-group">
                                                <label>@Lang["equip.tag"]</label>
                                                <InputText class="form-control" @bind-Value="Manual.Tag" />
                                                <ValidationMessage For="@(() => Manual.Tag)" class="text-danger small" />
                                            </div>
                                            <div class="form-group">
                                                <label>@Lang["equip.name"]</label>
                                                <InputText class="form-control" @bind-Value="Manual.EquipmentName" />
                                                <ValidationMessage For="@(() => Manual.EquipmentName)" class="text-danger small" />
                                            </div>
                                            <div class="form-group">
                                                <label>@Lang["equip.factory"]</label>
                                                <InputText class="form-control" @bind-Value="Manual.FactoryName" />
                                            </div>
                                            <div class="form-group">
                                                <label>@Lang["equip.revision"]</label>
                                                <InputDate class="form-control" @bind-Value="Manual.RevisionDate" />
                                            </div>
                                            <div class="form-group">
                                                <label>@Lang["equip.responsible"]</label>
                                                <input type="text"
                                                       class="form-control"
                                                       value="@Manual.ResponsibleUser"
                                                       disabled
                                                       style="background-color: #e9ecef; cursor: not-allowed;" />
                                            </div>
                                        </div>
                                    </div>

                                    @* I. IDENTIFICAÇÃO *@
                                    <div class="card card-outline card-info mb-2">
                                        <div class="card-header py-2">
                                            <h6 class="card-title mb-0">
                                                <i class="fas fa-exclamation-triangle mr-1"></i>
                                                @Lang["equip.identification"]
                                            </h6>
                                        </div>
                                        <div class="card-body py-2">
                                            <div class="form-group">
                                                <label>@Lang["equip.line_number"]</label>
                                                <InputNumber class="form-control" @bind-Value="Manual.LineNumber" />
                                                <ValidationMessage For="@(() => Manual.LineNumber)" class="text-danger small" />
                                            </div>
                                            <div class="form-group">
                                                <label>@Lang["equip.energy_type"]</label>
                                                <InputText class="form-control" @bind-Value="Manual.EnergyType" />
                                                <ValidationMessage For="@(() => Manual.EnergyType)" class="text-danger small" />
                                            </div>
                                            <div class="form-group">
                                                <label>@Lang["equip.energy_desc"]</label>
                                                <InputTextArea class="form-control" rows="4" @bind-Value="Manual.HazardDescription" />
                                                <ValidationMessage For="@(() => Manual.HazardDescription)" class="text-danger small" />
                                            </div>
                                            <div class="form-group">
                                                <label>@Lang["equip.zero_energy"]</label>
                                                <InputTextArea class="form-control" rows="2" @bind-Value="Manual.ZeroEnergyVerification" />
                                            </div>
                                            <div class="form-group">
                                                <label>@Lang["equip.test"]</label>
                                                <InputTextArea class="form-control" rows="2" @bind-Value="Manual.Test" />
                                            </div>
                                        </div>
                                    </div>

                                    @* II. CONTROLE *@
                                    <div class="card card-outline card-success mb-2">
                                        <div class="card-header py-2">
                                            <h6 class="card-title mb-0">
                                                <i class="fas fa-lock mr-1"></i>
                                                @Lang["equip.control"]
                                            </h6>
                                        </div>
                                        <div class="card-body py-2">
                                            <div class="form-group">
                                                <label>@Lang["equip.isolation_tag"]</label>
                                                <InputText class="form-control" @bind-Value="Manual.IsolationDeviceTag" />
                                            </div>
                                            <div class="form-group">
                                                <label>@Lang["equip.isolation_location"]</label>
                                                <InputText class="form-control" @bind-Value="Manual.IsolationDeviceLocation" />
                                            </div>
                                            <div class="form-group">
                                                <label>@Lang["equip.isolation_device"]</label>
                                                <InputText class="form-control" @bind-Value="Manual.IsolationDeviceDescription" />
                                            </div>
                                            <div class="form-group">
                                                <label>@Lang["equip.lockout"]</label>
                                                <InputText class="form-control" @bind-Value="Manual.LockoutType" />
                                            </div>
                                        </div>
                                    </div>

                                    @* IMAGENS *@
                                    <div class="form-group">
                                        <label>@Lang["equip.images"]</label>
                                        <InputFile OnChange="ImagensManuaisSelecionadas" accept="image/*" multiple />
                                        @if (!string.IsNullOrEmpty(Manual.ImageFileName))
                                        {
                                            <small class="form-text text-muted">
                                                @Lang["equip.selected_files"] @Manual.ImageFileName
                                            </small>
                                        }
                                </div>

                                <div class="form-group">
                                    <label>@Lang["equip.image_notes"]</label>
                                    <InputTextArea class="form-control" rows="4" @bind-Value="Manual.ImageNotes" />
                                </div>

                                <button type="submit"
                                        class="btn btn-success btn-block btn-sm"
                                        disabled="@(Importando || SalvandoManual)">
                                    <i class="fas fa-save mr-1"></i>
                                    @(SalvandoManual
                                        ? Lang["equip.saving"]
                                        : (IsEditMode ? Lang["equip.save_changes"] : Lang["equip.save_equipment"]))
                                    </button>
                                </EditForm>
                            }
                            else
                            {
                                @* IMPORTAÇÃO EXCEL *@
                                <div class="form-group">
                                    <label class="d-flex align-items-center justify-content-between">
                                        <span>@Lang["equip.select_excel"]</span>
                                        <button type="button"
                                                class="btn btn-xs btn-outline-info ml-2"
                                                title="@Lang["equip.view_template"]"
                                                @onclick="AbrirModalTemplate">
                                            <i class="fas fa-table mr-1"></i> @Lang["equip.view_template"]
                                        </button>
                                    </label>
                                    <InputFile OnChange="ArquivosExcelSelecionados"
                                               multiple
                                               accept=".xlsx"
                                               disabled="@Importando" />
                                    <small class="form-text text-muted">
                                        <i class="fas fa-info-circle mr-1"></i>
                                        @Lang["equip.template_hint"]
                                    </small>
                                </div>

                                @if (ArquivosImportacao.Any())
                                {
                                    <div class="position-relative">
                                        <div class="table-responsive">
                                            <table class="table table-sm table-striped table-bordered mb-2">
                                                <thead class="thead-light">
                                                    <tr>
                                                        <th>@Lang["equip.file_col"]</th>
                                                        <th>@Lang["equip.status_col"]</th>
                                                        <th>@Lang["equip.progress_col"]</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var a in ArquivosImportacao)
                                                    {
                                                        <tr>
                                                            <td>@a.Nome</td>
                                                            <td>
                                                                <span class="@ClasseBadgeStatus(a.Status)">
                                                                    @TranslateImportStatus(a.Status)
                                                                </span>
                                                                @if (!string.IsNullOrEmpty(a.MensagemErro))
                                                                {
                                                                    <div class="alert alert-danger alert-sm mt-1 mb-0 py-1 px-2" role="alert">
                                                                        <i class="fas fa-exclamation-circle mr-1"></i>
                                                                        @foreach (var linha in a.MensagemErro.Split('\n'))
                                                                        {
                                                                            <div>@linha</div>
                                                                        }
                                                                    </div>
                                                                }
                                                            </td>
                                                            <td style="width: 220px;">
                                                                <div class="progress progress-xs">
                                                                    <div class="progress-bar @(a.Status == "Erro" ? "bg-danger" : "")"
                                                                         role="progressbar"
                                                                         style="width: @a.Progresso%">
                                                                    </div>
                                                                </div>
                                                                <small>@a.Progresso %</small>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                        <button class="btn btn-primary btn-block btn-sm"
                                                disabled="@Importando"
                                                @onclick="IniciarImportacao">
                                            <i class="fas fa-file-import mr-1"></i>
                                            @(Importando ? Lang["equip.importing"] : Lang["equip.start_import"])
                                        </button>

                                        @if (!string.IsNullOrEmpty(MensagemImportacao))
                                        {
                                            <p class="mt-2 text-info">@MensagemImportacao</p>
                                        }

                                        @if (Importando)
                                        {
                                            <div class="overlay d-flex justify-content-center align-items-center">
                                                <i class="fas fa-sync-alt fa-spin fa-2x"></i>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted">@Lang["equip.no_file"]</p>
                                }
                            }
                        }

                        @* PASSO 3 *@
                        else if (passoAtual == 3)
                        {
                            <p>
                                @Lang["equip.complete"]
                                @Lang["equip.complete_desc"]
                            </p>
                            <p class="text-muted mb-0">
                                @Lang["equip.complete_desc2"]
                            </p>
                        }

                    </div>

                    <div class="card-footer d-flex justify-content-between">
                        @if (!IsEditMode && passoAtual < 3)
                        {
                            <button class="btn btn-secondary btn-sm"
                                    disabled="@(passoAtual == 1 || Importando || SalvandoManual)"
                                    @onclick="PassoAnterior">
                                <i class="fas fa-arrow-left mr-1"></i> @Lang["equip.previous"]
                            </button>
                            @if (!(passoAtual == 2 && ModoSelecionado == ModoCadastro.Manual))
                            {
                                <button class="btn btn-primary btn-sm"
                                        disabled="@(!PodeAvancarPasso())"
                                        @onclick="ProximoPasso">
                                    @Lang["equip.next"] <i class="fas fa-arrow-right ml-1"></i>
                                </button>
                            }
                        }
                        else
                        {
                            <button class="btn btn-primary btn-sm ml-auto"
                                    disabled="@(Importando || SalvandoManual)"
                                    @onclick="FecharWizard">
                                @Lang["equip.close"]
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- LINHA 2 – LISTA -->
        <div class="row">
            <div class="col-12">
                <div class="card card-info card-outline mb-3">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-list mr-1"></i>
                            @Lang["equip.list_title"]
                        </h3>
                        <div class="card-tools">
                            <div class="input-group input-group-sm" style="width: 260px;">
                                <input type="text"
                                       class="form-control float-right"
                                       placeholder="@Lang["equip.search_placeholder"]"
                                       @bind="TermoPesquisa"
                                       @bind:event="oninput"
                                       @bind:after="() => PaginaAtual = 1" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-default" title="@Lang["common.clear"]" @onclick="LimparPesquisa">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-2">
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
                            <div>
                                <small class="text-muted">
                                    @if (EquipamentosFiltrados?.Any() == true)
                                    {
                                        @($"{EquipamentosFiltrados.Count} {Lang["equip.found"]}")
                                    }
                                    else
                                    {
                                        @Lang["equip.not_found"]
                                    }
                                </small>
                            </div>
                            <div class="btn-group btn-group-sm">
                                <select class="form-control form-control-sm"
                                        style="width: 90px;"
                                        @bind="TamanhoPagina"
                                        @bind:after="ResetarPagina">
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                    <option value="150">150</option>
                                </select>
                            </div>
                        </div>

                        <div class="table-container">
                            <table class="table table-bordered table-hover table-sm mb-0 equip-table">
                                <thead class="sticky-header">
                                    <tr class="thead-light">
                                        <th colspan="6" class="text-center">@Lang["equip.col_identification"]</th>
                                        <th colspan="6" class="text-center">@Lang["equip.col_energy_control"]</th>
                                        <th rowspan="2" style="width: 5%;" class="text-center align-middle">@Lang["equip.col_active"]</th>
                                        <th rowspan="2" style="width: 15%;" class="text-right align-middle">@Lang["equip.col_actions"]</th>
                                    </tr>
                                    <tr class="thead-light">
                                        <th style="width: 8%;">Tag</th>
                                        <th style="width: 22%;">Equip.</th>
                                        <th style="width: 6%;">Nº</th>
                                        <th style="width: 10%;">@Lang["home.table.energy_type"]</th>
                                        <th style="width: 5%;">Img</th>
                                        <th style="width: 18%;">@Lang["home.table.energy_desc"]</th>
                                        <th style="width: 10%;">@Lang["home.table.isolation_tag"]</th>
                                        <th style="width: 14%;">@Lang["home.table.loc_device"]</th>
                                        <th style="width: 10%;">@Lang["home.table.device"]</th>
                                        <th style="width: 8%;">@Lang["home.table.lockout"]</th>
                                        <th style="width: 14%;">@Lang["home.table.zero_energy"]</th>
                                        <th style="width: 14%;">@Lang["home.table.test"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (EquipamentosPaginados.Any())
                                    {
                                        @foreach (var e in EquipamentosPaginados)
                                        {
                                            <tr class="@(e.IsDeleted ? "table-danger" : "")">
                                                <td>
                                                    @e.Tag
                                                    @if (equipamentosComPle.ContainsKey(e.Id))
                                                    {
                                                        var pleStatus = equipamentosComPle[e.Id];
                                                        var pleBloqueioAtivo = pleStatus == EToto.Domain.Enums.StatusPle.EmAndamento || pleStatus == EToto.Domain.Enums.StatusPle.InicioDesbloqueio;
                                                        var badgeMsg = pleBloqueioAtivo ? Lang["ple.maintenance_badge_active"] : Lang["ple.maintenance_badge"];
                                                        var badgeCss = pleBloqueioAtivo ? "badge-danger" : "badge-warning";
                                                        <span class="badge @badgeCss ml-1 ple-blink" title="@badgeMsg">
                                                            <i class="fas fa-lock"></i>
                                                        </span>
                                                    }
                                                </td>
                                                <td>@e.EquipmentName</td>
                                                <td>@e.LineNumber</td>
                                                <td style="@GetEstiloTipoEnergia(e.EnergyType)" class="energy-type-cell">
                                                    <span class="energy-type-text">@e.EnergyType</span>
                                                </td>
                                                <td class="text-center">
                                                    @if (!string.IsNullOrEmpty(e.ImageBlobUrl))
                                                    {
                                                        <button class="btn btn-xs btn-outline-secondary"
                                                                title="@Lang["equip.view_img_notes"]"
                                                                @onclick="() => AbrirModalImagem(e)">
                                                            <i class="fas fa-image"></i>
                                                        </button>
                                                    }
                                                </td>
                                                <td>@e.HazardDescription</td>
                                                <td>@e.IsolationDeviceTag</td>
                                                <td>@e.IsolationDeviceLocation</td>
                                                <td>@e.IsolationDeviceDescription</td>
                                                <td>@e.LockoutType</td>
                                                <td>@e.ZeroEnergyVerification</td>
                                                <td>@e.Test</td>
                                                <td class="text-center">
                                                    @if (!e.IsDeleted)
                                                    {
                                                        <span class="badge bg-success badge-sm">@Lang["common.active"]</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary badge-sm">@Lang["common.inactive"]</span>
                                                    }
                                                </td>
                                                <td class="text-right">
                                                    <button class="btn btn-xs btn-outline-primary"
                                                            title="@Lang["common.edit"]"
                                                            disabled="@Importando"
                                                            @onclick="() => IniciarEdicao(e)">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-xs btn-outline-danger"
                                                            title="@Lang["common.delete"]"
                                                            disabled="@Importando"
                                                            @onclick="() => AbrirModalConfirmacaoExclusao(e)">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="14" class="text-center text-muted py-3">
                                                @Lang["equip.no_records"]
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card-footer clearfix">
                        <span class="text-muted">@Lang["common.page"] @PaginaAtual @Lang["common.of"] @TotalPaginas</span>
                        <ul class="pagination pagination-sm m-0 float-right">
                            <li class="page-item @(PaginaAtual == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="PaginaAnterior">«</button>
                            </li>
                            @foreach (var pagina in GetPaginasVisiveis())
                            {
                                @if (pagina.HasValue)
                                {
                                    <li class="page-item @(PaginaAtual == pagina.Value ? "active" : "")">
                                        <button class="page-link" @onclick="() => IrParaPagina(pagina.Value)">@pagina.Value</button>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                            }
                            <li class="page-item @(PaginaAtual == TotalPaginas ? "disabled" : "")">
                                <button class="page-link" @onclick="ProximaPagina">»</button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        @* ======================================================
           MODAL — IMAGEM
           ====================================================== *@
        @if (MostrarModalImagem)
        {
            <div class="modal fade show" tabindex="-1" role="dialog" style="display:block;" aria-modal="true">
                <div class="modal-dialog modal-lg modal-dialog-centered modal-image" role="document">
                    <div class="modal-content">
                        <div class="modal-header bg-pw-blue text-white py-2">
                            <h5 class="modal-title mb-0">
                                <i class="fas fa-image mr-1"></i> @ImagemModalTitulo
                            </h5>
                            <button type="button" class="close text-white" aria-label="Close" @onclick="FecharModalImagem">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <div class="d-flex flex-column flex-md-row align-items-start modal-image-content">
                                <div class="modal-image-wrapper text-center mb-3 mb-md-0 flex-fill">
                                    @if (!string.IsNullOrEmpty(ImagemModalUrl))
                                    {
                                        <img src="@ImagemModalUrl" class="img-fluid rounded shadow-sm" />
                                    }
                                    else
                                    {
                                        <p class="text-muted">@Lang["equip.image_unavailable"]</p>
                                    }
                                </div>
                                <div class="modal-notes-wrapper ml-md-3">
                                    <h6 class="mb-2 text-muted">
                                        <i class="fas fa-sticky-note mr-1"></i> @Lang["equip.notes"]
                                    </h6>
                                    @if (!string.IsNullOrWhiteSpace(ImagemModalNotas))
                                    {
                                        <div class="image-notes-bubble">@ImagemModalNotas</div>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0">@Lang["equip.no_notes"]</p>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer py-2">
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="FecharModalImagem">@Lang["common.close"]</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-backdrop fade show"></div>
        }

        @* ======================================================
           MODAL — CONFIRMAÇÃO EXCLUSÃO
           ====================================================== *@
