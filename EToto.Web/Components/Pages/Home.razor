        ImagemModalUrl = null;
        ImagemModalTitulo = null;
        ImagemModalNotas = null;
    }

    private string ObterNomePlanta(int plantaId)
    {
        var planta = PlantasDoUsuario.FirstOrDefault(p => p.Id == plantaId);
        return planta != null ? $"{planta.Nome} ({planta.Codigo})" : "N/A";
    }

    private string GetEstiloTipoEnergia(string? tipoEnergia)
    {
        if (string.IsNullOrWhiteSpace(tipoEnergia))
            return string.Empty;

        // Se houver múltiplas energias separadas por "/", pegar apenas a primeira
        var primeiraPalavra = tipoEnergia.Split('/')[0].Trim();
        var tipo = RemoverAcentos(primeiraPalavra).ToUpperInvariant().Trim();

        var corFundo = tipo switch
        {
            var t when t.Contains("ELETRICA") || t.Contains("ELETRIC") => "#FF2929",
            var t when t.Contains("GRAVITACIONAL") => "#D4C19C",
            var t when t.Contains("PNEUMATICA") => "#4BDFF3",
            var t when t.Contains("MECANICA") => "#8C8C8C",
            var t when t.Contains("GAS") || t.Contains("GÁS") => "#E9E6D7",
            var t when t.Contains("HIDRAULICA") => "#0041DA",
            var t when t.Contains("QUIMICA") => "#FFC301",
            var t when t.Contains("RADIACAO") || t.Contains("RADIAÇÃO") => "#FFFF00",
            var t when t.Contains("TERMICA") || t.Contains("TÉRMICA") => "#DAEFF3",
            _ => "transparent"
        };

        var corTexto = corFundo switch
        {
            "#FF2929" => "white",
            "#0041DA" => "white",
            "#8C8C8C" => "white",
            _ => "#333"
        };

        if (corFundo == "transparent")
            return string.Empty;

        return $"background-color: {corFundo}; color: {corTexto}; font-weight: 600; border-left-color: {corFundo};";
    }
