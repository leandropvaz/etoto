@page "/"
@rendermode InteractiveServer

@using EToto.Web.Dto
@using EToto.Web.Services
@using EToto.Application.Dto
@using EToto.Application.Services
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Options

@inject NavigationManager Nav
@inject AuthService AuthService
@inject PlantasService PlantaService
@inject IOptions<LototoConfig> Config
@inject LanguageService Lang
@inject AmbienteInfo Ambiente
@implements IDisposable

@layout EmptyLayout

<div class="login-page">
    <div class="login-sheet">

        <div class="login-sheet__head">
            <img src="/images/etoto.png" alt="E-toto" class="login-logo" />

            @if (Ambiente.EhHomologacao)
            {
                <span class="pw-sig pw-sig--caution">@Lang["env.homologacao"]</span>
            }
        </div>

        <div class="login-sheet__body">
            <EditForm Model="@vm" OnValidSubmit="LoginAsync">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label class="form-label" for="login-user">@Lang["login.login"]</label>
                    <InputText @bind-Value="vm.Login"
                               id="login-user"
                               class="form-control"
                               autocomplete="username"
                               @oninput="OnLoginChanged" />
                    <ValidationMessage For="@(() => vm.Login)" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="login-pass">
                        @Lang["login.password"]
                        @if (PermiteLoginSemSenha)
                        {
                            <span class="pw-sig pw-sig--notice login-label-flag">@Lang["login.direct_access"]</span>
                        }
                    </label>
                    <InputText @bind-Value="vm.Senha"
                               id="login-pass"
                               type="password"
                               class="form-control"
                               autocomplete="current-password"
                               disabled="@PermiteLoginSemSenha"
                               placeholder="@(PermiteLoginSemSenha ? Lang["login.field_blocked"] : "")" />
                </div>

                <div class="form-group">
                    <label class="form-label" for="login-plant">@Lang["login.plant"]</label>
                    <InputSelect @bind-Value="vm.PlantaId" id="login-plant" class="form-control">
                        <option value="">@Lang["login.select"]</option>
                        @foreach (var planta in Plantas)
                        {
                            <option value="@planta.Id">
                                @planta.Nome (@planta.Codigo)
                            </option>
                        }
                    </InputSelect>
                </div>

                <button class="btn btn-primary btn-lg btn-block" disabled="@Entrando">
                    @if (Entrando)
                    {
                        <span><i class="fas fa-sync-alt fa-spin"></i> @Lang["login.signing_in"]</span>
                    }
                    else
                    {
                        @Lang["login.enter"]
                    }
                </button>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="pw-sigband pw-sigband--danger mt-3 mb-0">
                        <span>@errorMessage</span>
                    </div>
                }

                @* #2/#3: avisos de validade (acesso/treinamento). Mostrados APÓS o login, com Continuar. *@
                @if (warningMessages.Count > 0)
                {
                    <div class="pw-sigband pw-sigband--warn mt-3 mb-0 login-warnings">
                        <div>
                            @foreach (var msg in warningMessages)
                            {
                                <div class="login-warning">@msg</div>
                            }
                        </div>
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-lg btn-block mt-2"
                            @onclick="ProsseguirAposAvisoAsync">
                        @Lang["login.continue"]
                    </button>
                }
            </EditForm>
        </div>

        <div class="login-sheet__foot">
            @* Símbolo + escrito. O escrito (logo3) faltava aqui, então a marca
               aparecia pela metade. Sem filtro e sem opacidade: é marca de
               cliente, não elemento decorativo. *@
            <a href="https://www.powerwavesolutions.net" target="_blank" rel="noopener">
                <img src="/images/logo2.png" alt="Power Wave Solutions" />
                <img src="/images/logo3.png" alt="" />
            </a>
        </div>
    </div>
</div>

<style>
    /* Cena clara e macia: fundo cinza-azulado com um halo de cor bem lavado,
       e o cartão flutuando no centro. Sem grade de papel milimetrado. */
    .login-page {
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--pw-5);
        padding-top: max(var(--pw-5), env(safe-area-inset-top));
        padding-bottom: max(var(--pw-5), env(safe-area-inset-bottom));
        background:
            radial-gradient(90ch 60ch at 50% -10%, rgba(21,112,219,.10), transparent 60%),
            var(--pw-paper);
    }

    .login-sheet {
        width: 100%;
        max-width: 420px;
        background: var(--pw-sheet);
        border: 1px solid var(--pw-hair);
        border-radius: var(--pw-r-4);
        box-shadow: var(--pw-sh-3);
        overflow: hidden;
    }

    .login-sheet__head {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--pw-3);
        padding: var(--pw-7) var(--pw-5) var(--pw-4);
    }

    .login-logo { max-width: 190px; width: 100%; height: auto; display: block; }

    .login-sheet__body { padding: 0 var(--pw-5) var(--pw-5); }

    .login-label-flag { margin-left: var(--pw-2); vertical-align: middle; }

    .login-warning + .login-warning { margin-top: var(--pw-1); }
    .login-warnings { align-items: flex-start; }

    .login-sheet__foot {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: var(--pw-4);
        background: var(--pw-vellum-2);
        border-top: 1px solid var(--pw-hair);
    }

    .login-sheet__foot a {
        display: inline-flex;
        align-items: center;
        gap: var(--pw-2);
    }

    .login-sheet__foot img { height: 22px; width: auto; display: block; }

    @@media (max-width: 460px) {
        .login-page { padding: var(--pw-3); }
        .login-sheet { max-width: none; }
    }
</style>

@code {
    private LoginDto vm = new();
    private string errorMessage = string.Empty;
    private List<string> warningMessages = new();
    private string _pendingDestino = string.Empty;

    // #10: feedback visual durante a autenticação.
    private bool Entrando { get; set; }

    private List<PlantasDto> Plantas { get; set; } = new();
    private string? _returnUrl;

    private bool PermiteLoginSemSenha =>
        Config.Value.PermiteSemSenha(vm.Login);

    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= StateHasChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        vm = new LoginDto();

        // lê ReturnUrl se veio (?ReturnUrl=/home)
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("ReturnUrl", out var values))
        {
            _returnUrl = values.FirstOrDefault();
        }

        var dtos = await PlantaService.ListarAsync();
        Plantas = dtos.OrderBy(p => p.Nome).ToList();
    }

    private void OnLoginChanged(ChangeEventArgs e)
    {
        vm.Login = e.Value?.ToString() ?? string.Empty;

        // Limpa a senha quando bloquear o campo
        if (PermiteLoginSemSenha)
        {
            vm.Senha = string.Empty;
        }

        StateHasChanged(); // Força re-render para bloquear/desbloquear o campo
    }

    private async Task LoginAsync()
    {
        if (Entrando) return; // evita duplo clique
        Entrando = true;
        errorMessage = string.Empty;
        warningMessages.Clear();

        LoginResult resultado;
        try
        {
            // planta passa a ser opcional aqui
            int? plantaId = vm.PlantaId;
            if (plantaId == 0)
                plantaId = null;

            resultado = await AuthService.LoginAsync(vm.Login, vm.Senha, plantaId);
        }
        catch
        {
            Entrando = false;
            throw;
        }

        if (!resultado.Success)
        {
            // #2: acesso vencido (Terceiro).
            if (resultado.AcessoVencido)
                errorMessage = Lang["login.access_expired"];
            // #3: treinamento vencido.
            else if (resultado.TreinamentoVencido)
                errorMessage = Lang["login.training_expired"];
            else
                errorMessage = resultado.ErrorMessage ?? Lang["login.auth_error"];
            Entrando = false;
            return;
        }

        var destino = string.IsNullOrWhiteSpace(_returnUrl) ? "/home" : _returnUrl;

        // #2/#3: agrega banners de validade (acesso e/ou treinamento) e exige "Continuar".
        if (resultado.DiasParaVencer.HasValue)
        {
            warningMessages.Add(resultado.DiasParaVencer.Value == 0
                ? Lang["login.access_expiring_today"]
                : string.Format(Lang["login.access_expiring_in_days"], resultado.DiasParaVencer.Value));
        }
        if (resultado.DiasParaVencerTreinamento.HasValue)
        {
            warningMessages.Add(resultado.DiasParaVencerTreinamento.Value == 0
                ? Lang["login.training_expiring_today"]
                : string.Format(Lang["login.training_expiring_in_days"], resultado.DiasParaVencerTreinamento.Value));
        }

        if (warningMessages.Count > 0)
        {
            _pendingDestino = destino;
            Entrando = false;
            return;
        }

        // sucesso pleno: leva pra próxima página com NavigateTo(forceLoad).
        // Entrando segue true até o reload terminar — botão fica em "Entrando..." durante a transição.
        Nav.NavigateTo(destino, forceLoad: true);
    }

    private Task ProsseguirAposAvisoAsync()
    {
        var destino = string.IsNullOrWhiteSpace(_pendingDestino) ? "/home" : _pendingDestino;
        Nav.NavigateTo(destino, forceLoad: true);
        return Task.CompletedTask;
    }
}
