@using EToto.Application.Dto
@using EToto.Application.Services
@using EToto.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject CampanhaRevalidacaoService CampanhaSvc
@inject LanguageService Lang
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

<div class="modal fade show" style="display:block;" tabindex="-1" aria-modal="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable campanha-detalhe-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title mb-0">
                    <i class="fas fa-bullhorn mr-2"></i>@(Campanha?.Nome ?? Lang["campaign.title"])
                </h5>
                <button type="button" class="close text-white" @onclick="FecharAsync">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body p-3">

        @if (Carregando)
        {
            <div class="text-center text-muted py-4">
                <i class="fas fa-sync-alt fa-spin mr-2"></i>@Lang["common.loading"]
            </div>
        }
        else if (Campanha is null)
        {
            <div class="alert alert-warning">@Lang["campaign.no_results"]</div>
        }
        else
        {
            <div class="card card-primary card-outline mb-3">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-bullhorn mr-1"></i>@Campanha.Nome
                    </h3>
                    <div class="card-tools">
                        @if (Campanha.Status == 2)
                        {
                            @if (ConfirmandoCancelamento)
                            {
                                <span class="text-danger small mr-2">@Lang["campaign.cancel_confirm"]</span>
                                <button class="btn btn-danger btn-sm mr-1" disabled="@Cancelando" @onclick="CancelarAsync">
                                    @if (Cancelando)
                                    {
                                        <span><i class="fas fa-sync-alt fa-spin mr-1"></i>@Lang["common.processing"]</span>
                                    }
                                    else
                                    {
                                        <span><i class="fas fa-ban mr-1"></i>@Lang["campaign.cancel_yes"]</span>
                                    }
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" disabled="@Cancelando"
                                        @onclick="() => ConfirmandoCancelamento = false">
                                    @Lang["common.no"]
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-success btn-sm mr-1" disabled="@Concluindo" @onclick="ConcluirAsync">
                                    @if (Concluindo)
                                    {
                                        <span><i class="fas fa-sync-alt fa-spin mr-1"></i>@Lang["common.processing"]</span>
                                    }
                                    else
                                    {
                                        <span><i class="fas fa-check mr-1"></i>@Lang["campaign.complete"]</span>
                                    }
                                </button>
                                <button class="btn btn-outline-danger btn-sm" disabled="@Concluindo"
                                        @onclick="() => ConfirmandoCancelamento = true">
                                    <i class="fas fa-ban mr-1"></i>@Lang["campaign.cancel"]
                                </button>
                            }
                        }
                    </div>
                </div>
                <div class="card-body p-3">
                    <div class="row">
                        <div class="col-6 col-md-4">
                            <small class="text-muted d-block">@Lang["campaign.status"]</small>
                            <span class="badge @StatusBadge(Campanha.Status) badge-sm">@TraduzirStatus(Campanha.Status)</span>
                        </div>
                        <div class="col-6 col-md-4">
                            <small class="text-muted d-block">@Lang["campaign.start"]</small>
                            @Campanha.DataInicio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </div>
                        <div class="col-6 col-md-4">
                            <small class="text-muted d-block">@Lang["campaign.end_expected"]</small>
                            @Campanha.DataFimPrevista.ToLocalTime().ToString("dd/MM/yyyy")
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Campanha.Notas))
                    {
                        <div class="mt-2"><small class="text-muted">@Lang["campaign.notes"]:</small> @Campanha.Notas</div>
                    }
                    <div class="mt-2">
                        <small class="text-muted">@Lang["campaign.progress"]:</small>
                        <strong>@Campanha.ItensDecididos / @Campanha.TotalItens</strong>
                    </div>
                </div>
            </div>

            <div class="card card-info card-outline">
                <div class="card-body p-2">

                    @* Filtros da tabela de itens (mesma pegada das demais telas) *@
                    <div class="row align-items-end mb-2">
                        <div class="col-12 col-md-5">
                            <label>@Lang["campaign.filter.user"]</label>
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="@Lang["campaign.filter.search_placeholder"]"
                                   @bind="FiltroTexto" @bind:event="oninput" />
                        </div>
                        <div class="col-8 col-md-4">
                            <label>@Lang["campaign.filter.decision"]</label>
                            <select class="form-control form-control-sm" @bind="FiltroDecisao">
                                <option value="">@Lang["campaign.filter.all"]</option>
                                <option value="0">@Lang["campaign.decision_pending"]</option>
                                <option value="1">@Lang["campaign.decision_keep"]</option>
                                <option value="3">@Lang["campaign.decision_revoke"]</option>
                            </select>
                        </div>
                        <div class="col-4 col-md-3 d-flex justify-content-between align-items-center">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="LimparFiltro">
                                <i class="fas fa-times"></i> @Lang["audit.filter.clear"]
                            </button>
                            <small class="text-muted ml-2">@ItensFiltrados.Count / @Itens.Count</small>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover table-sm mb-0 detail-table">
                            <thead class="thead-light">
                                <tr>
                                    <th style="width: 18%;">@Lang["campaign.col_user"]</th>
                                    <th style="width: 32%;">@Lang["campaign.col_snapshot"]</th>
                                    <th style="width: 14%;">@Lang["campaign.col_decision"]</th>
                                    <th style="width: 12%;">@Lang["campaign.col_who"]</th>
                                    <th style="width: 12%;">@Lang["campaign.col_when"]</th>
                                    <th style="width: 12%;">@Lang["campaign.col_note"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ItensFiltrados.Count == 0)
                                {
                                    <tr><td colspan="6" class="text-center text-muted py-3">@Lang["campaign.no_results"]</td></tr>
                                }
                                else
                                {
                                    @foreach (var item in ItensFiltrados)
                                    {
                                        var draft = ObterDraft(item);
                                        <tr class="@(item.Decisao == 3 ? "table-danger" : item.Decisao.HasValue ? "table-success" : "")">
                                            <td class="align-middle">
                                                <div class="font-weight-bold">@item.UsuarioNome</div>
                                                <small class="text-muted">@item.UsuarioLogin</small>
                                            </td>
                                            <td class="small align-middle">@item.SnapshotResumo</td>
                                            <td class="align-middle">
                                                @if (item.Decisao.HasValue)
                                                {
                                                    <span class="badge @DecisaoBadge(item.Decisao!.Value)">
                                                        @TraduzirDecisao(item.Decisao!.Value)
                                                    </span>
                                                }
                                                else if (Campanha.Status == 2)
                                                {
                                                    <select class="form-control form-control-sm"
                                                            @bind="draft.Decisao">
                                                        <option value="0">@Lang["campaign.decision_pending"]</option>
                                                        <option value="1">@Lang["campaign.decision_keep"]</option>
                                                        <option value="3">@Lang["campaign.decision_revoke"]</option>
                                                    </select>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">@Lang["campaign.decision_pending"]</span>
                                                }
                                            </td>
                                            <td class="small align-middle">@(item.DecididoPorNome ?? "—")</td>
                                            <td class="small align-middle">@(item.DecididoEm?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                            <td class="align-middle">
                                                @if (item.Decisao.HasValue)
                                                {
                                                    <small>@item.Observacao</small>
                                                }
                                                else if (Campanha.Status == 2)
                                                {
                                                    <div class="d-flex flex-column" style="gap: 4px;">
                                                        <input class="form-control form-control-sm"
                                                               placeholder="@Lang["campaign.col_note"]"
                                                               @bind="draft.Observacao" />
                                                        <button class="btn btn-xs btn-primary align-self-stretch"
                                                                @onclick="() => SalvarItemAsync(item, draft)"
                                                                disabled="@(draft.Decisao == 0 || SalvandoItens.Contains(item.Id))">
                                                            @if (SalvandoItens.Contains(item.Id))
                                                            {
                                                                <span><i class="fas fa-sync-alt fa-spin mr-1"></i>@Lang["common.processing"]</span>
                                                            }
                                                            else
                                                            {
                                                                <span><i class="fas fa-save mr-1"></i>@Lang["campaign.save_decision"]</span>
                                                            }
                                                        </button>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

            </div> @* modal-body *@
        </div>
    </div>
</div>
<div class="modal-backdrop fade show"></div>

<style>
    .detail-table th, .detail-table td { font-size: 0.78rem; padding: 0.3rem 0.4rem; vertical-align: middle; }

    /* Modal de detalhe um pouco maior que o modal-xl padrão */
    .campanha-detalhe-dialog {
        max-width: min(1500px, 95vw);
    }
</style>

@code {
    [Parameter] public int Id { get; set; }
    // Fecha o modal (volta para a lista de revalidação).
    [Parameter] public EventCallback OnFechar { get; set; }
    // Notifica o pai que houve alteração (decisão/conclusão) para recarregar a lista.
    [Parameter] public EventCallback OnAtualizado { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private CampanhaRevalidacaoDto? Campanha { get; set; }
    private List<ItemCampanhaDto> Itens { get; set; } = new();
    private Dictionary<int, DraftDecisao> Drafts { get; set; } = new();
    private int? UsuarioIdLogado { get; set; }
    private int _idCarregado;

    // Filtros da tabela de itens.
    private string FiltroTexto { get; set; } = string.Empty;
    private string FiltroDecisao { get; set; } = string.Empty; // "" todos; "0" pendentes; "1/2/3" decisões

    private List<ItemCampanhaDto> ItensFiltrados =>
        Itens.Where(i =>
        {
            if (!string.IsNullOrWhiteSpace(FiltroTexto))
            {
                var termo = FiltroTexto.Trim();
                var bateTexto =
                    (i.UsuarioNome ?? "").Contains(termo, StringComparison.OrdinalIgnoreCase) ||
                    (i.UsuarioLogin ?? "").Contains(termo, StringComparison.OrdinalIgnoreCase) ||
                    (i.SnapshotResumo ?? "").Contains(termo, StringComparison.OrdinalIgnoreCase);
                if (!bateTexto) return false;
            }

            if (!string.IsNullOrEmpty(FiltroDecisao))
            {
                var alvo = int.Parse(FiltroDecisao);
                // "0" = pendentes (sem decisão); demais = decisão específica.
                var atual = i.Decisao ?? 0;
                if (atual != alvo) return false;
            }

            return true;
        }).ToList();

    private void LimparFiltro()
    {
        FiltroTexto = string.Empty;
        FiltroDecisao = string.Empty;
    }

    // #9: indicadores de carregamento
    private bool Carregando { get; set; } = true;
    private bool Concluindo { get; set; }
    private bool Cancelando { get; set; }
    private bool ConfirmandoCancelamento { get; set; }
    private HashSet<int> SalvandoItens { get; } = new();

    protected override void OnInitialized() => Lang.OnLanguageChanged += StateHasChanged;
    public void Dispose() => Lang.OnLanguageChanged -= StateHasChanged;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateTask;
        var user = state.User;
        if (int.TryParse(user.FindFirst("UserId")?.Value, out var uid)) UsuarioIdLogado = uid;
    }

    // Recarrega ao abrir/trocar de campanha (o modal é reaproveitado pelo pai).
    protected override async Task OnParametersSetAsync()
    {
        if (Id != _idCarregado)
        {
            _idCarregado = Id;
            await CarregarAsync();
        }
    }

    private async Task FecharAsync() => await OnFechar.InvokeAsync();

    private async Task CarregarAsync()
    {
        try
        {
            Carregando = true;
            var (c, itens) = await CampanhaSvc.ObterDetalheAsync(Id);
            Campanha = c;
            Itens = itens;
            Drafts.Clear();
        }
        finally
        {
            Carregando = false;
        }
    }

    private DraftDecisao ObterDraft(ItemCampanhaDto item)
    {
        if (!Drafts.TryGetValue(item.Id, out var d))
        {
            d = new DraftDecisao();
            Drafts[item.Id] = d;
        }
        return d;
    }

    private async Task SalvarItemAsync(ItemCampanhaDto item, DraftDecisao draft)
    {
        if (draft.Decisao == 0) return;
        try
        {
            SalvandoItens.Add(item.Id);
            await CampanhaSvc.DecidirItemAsync(new DecidirItemDto
            {
                CampanhaId = item.CampanhaId,
                ItemId = item.Id,
                Decisao = draft.Decisao,
                Observacao = draft.Observacao,
                ExecutadoPorId = UsuarioIdLogado ?? 0
            });
            await Js.InvokeVoidAsync("adminlteToasts.show", "success",
                Lang["common.success"], Lang["campaign.toast.decided"]);
            await CarregarAsync();
            await OnAtualizado.InvokeAsync();
        }
        catch (Exception ex)
        {
            await Js.InvokeVoidAsync("adminlteToasts.show", "error", Lang["common.error"], ex.Message);
        }
        finally
        {
            SalvandoItens.Remove(item.Id);
        }
    }

    private async Task ConcluirAsync()
    {
        try
        {
            Concluindo = true;
            await CampanhaSvc.ConcluirAsync(Id);
            await Js.InvokeVoidAsync("adminlteToasts.show", "success",
                Lang["common.success"], Lang["campaign.toast.completed"]);
            await CarregarAsync();
            await OnAtualizado.InvokeAsync();
        }
        catch (Exception ex)
        {
            await Js.InvokeVoidAsync("adminlteToasts.show", "error", Lang["common.error"], ex.Message);
        }
        finally
        {
            Concluindo = false;
        }
    }

    private async Task CancelarAsync()
    {
        try
        {
            Cancelando = true;
            await CampanhaSvc.CancelarAsync(Id);
            await Js.InvokeVoidAsync("adminlteToasts.show", "success",
                Lang["common.success"], Lang["campaign.toast.cancelled"]);
            await OnAtualizado.InvokeAsync();
            await OnFechar.InvokeAsync();
        }
        catch (Exception ex)
        {
            await Js.InvokeVoidAsync("adminlteToasts.show", "error", Lang["common.error"], ex.Message);
        }
        finally
        {
            Cancelando = false;
            ConfirmandoCancelamento = false;
        }
    }

    private string TraduzirStatus(int s) => s switch
    {
        1 => Lang["campaign.status_planned"],
        2 => Lang["campaign.status_running"],
        3 => Lang["campaign.status_completed"],
        4 => Lang["campaign.status_cancelled"],
        _ => s.ToString()
    };

    private string TraduzirDecisao(int d) => d switch
    {
        1 => Lang["campaign.decision_keep"],
        2 => Lang["campaign.decision_adjust"],
        3 => Lang["campaign.decision_revoke"],
        _ => Lang["campaign.decision_pending"]
    };

    private static string StatusBadge(int s) => s switch
    {
        2 => "bg-info text-white",
        3 => "bg-success text-white",
        4 => "bg-danger text-white",
        _ => "bg-secondary text-white"
    };

    private static string DecisaoBadge(int d) => d switch
    {
        1 => "bg-success text-white",
        2 => "bg-warning text-dark",
        3 => "bg-danger text-white",
        _ => "bg-secondary text-white"
    };

    private class DraftDecisao
    {
        public int Decisao { get; set; }
        public string? Observacao { get; set; }
    }
}
